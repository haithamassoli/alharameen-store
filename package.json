{
  "name": "alharameen-store",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro sync && ultracite check",
    "dev": "astro dev",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "lefthook install",
    "preview": "astro preview",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
    "typecheck": "astro check",
    "validate": "pnpm check && pnpm typecheck && pnpm knip && pnpm test && pnpm build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/astro": "^2.0.2",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^6.0.3",
    "ultracite": "8.3.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.11.2"
}
