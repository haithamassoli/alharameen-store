---
import { Picture } from "astro:assets";
// One product in a grid or strip: photo on chalk, category, name (links to
// the product page), price and an add-to-cart button.
import type { CollectionEntry } from "astro:content";

import { formatPrice } from "../lib/money";

interface Props {
  product: CollectionEntry<"products">;
  categoryName: string;
}

const IMAGE_SIZE = 560;

const { product, categoryName } = Astro.props;
const { id, data } = product;
const [cover] = data.images;
const [variant] = data.variants;
const url = `/watches/${id}/`;
const inStock = variant.stock > 0;
---

<article class="product-card">
  <div
    class="product-card__frame"
    style={`view-transition-name: product-${id}-image`}
  >
    <Picture
      alt={cover.alt}
      class="product-card__image"
      formats={["avif", "webp"]}
      height={IMAGE_SIZE}
      loading="lazy"
      sizes="(min-width: 64rem) 17rem, (min-width: 40rem) 30vw, 45vw"
      src={cover.src}
      width={IMAGE_SIZE}
      widths={[280, 420, IMAGE_SIZE]}
    />
  </div>

  <div class="product-card__body">
    <p class="product-card__category">{categoryName}</p>
    <h3 class="product-card__name">
      <a
        class="product-card__link"
        href={url}
        style={`view-transition-name: product-${id}-name`}
      >
        {data.name}
      </a>
    </h3>

    <div class="product-card__footer">
      <p class="product-card__price price">
        <span class="visually-hidden">السعر:</span>
        {formatPrice(data.price, data.currency)}
        {data.compareAtPrice !== undefined && (
          <s class="product-card__was">
            <span class="visually-hidden">بدلًا من</span>
            {formatPrice(data.compareAtPrice, data.currency)}
          </s>
        )}
      </p>
      {inStock ? (
        <button class="product-card__add" data-add-to-cart={id} type="button">
          أضف <span class="visually-hidden">{data.name}</span> للسلة
        </button>
      ) : (
        <p class="product-card__out">نفدت الكمية حاليًا</p>
      )}
    </div>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
  }

  /* A grid, so the stretched <picture> has a definite height to fill. */
  .product-card__frame {
    display: grid;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--chalk);
  }

  /* White studio photos melt into the chalk ground. */
  .product-card__image {
    inline-size: 100%;
    block-size: 100%;
    padding: 8%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: scale 700ms var(--ease);
  }

  .product-card:hover .product-card__image {
    scale: 1.04;
  }

  .product-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-block-start: var(--space-4);
  }

  .product-card__category {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .product-card__name {
    margin-block: 0.125rem 0.625rem;
    font-size: var(--text-base);
    line-height: 1.55;
  }

  .product-card__link {
    text-decoration: none;
  }

  /* The whole card is the link; the add button sits above it. */
  .product-card__link::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
  }

  .product-card:has(.product-card__link:focus-visible) {
    outline: 2px solid var(--pine);
    outline-offset: 6px;
  }

  .product-card__link:focus-visible {
    outline: none;
  }

  .product-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    margin-block-start: auto;
    padding-block-start: 0.625rem;
    border-block-start: 1px solid var(--hairline);
  }

  .product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-base);
    font-weight: 500;
  }

  .product-card__was {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .product-card__add {
    position: relative;
    z-index: 2;
    min-block-size: 2.5rem;
    padding-block: 0;
    padding-inline: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--white);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .product-card__add:hover {
    border-color: var(--pine);
    background: var(--pine);
    color: var(--white);
  }

  .product-card__out {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    .product-card__name,
    .product-card__price {
      font-size: var(--text-md);
    }

    .product-card__add {
      flex: 1 1 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card:hover .product-card__image {
      scale: 1;
    }
  }
</style>
