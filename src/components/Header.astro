---
import Logo from "../assets/logo.svg";

const links = [
  { href: "/#watches", label: "الساعات" },
  { href: "/#features", label: "المزايا" },
  { href: "/guides/", label: "الشروحات" },
  { href: "/#contact", label: "تواصل معنا" },
] as const;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a aria-label="ساعات الحرمين، الصفحة الرئيسية" class="wordmark" href="/">
      <Logo aria-hidden="true" class="wordmark__logo" />
      <span>ساعات الحرمين</span>
    </a>

    <nav aria-label="التنقل الرئيسي" class="site-nav">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button aria-label="السلة" class="cart-button" data-cart-open type="button">
      <svg aria-hidden="true" fill="none" viewBox="0 0 24 24">
        <path
          d="M5.5 8.5h13l-1 11.2a1.5 1.5 0 0 1-1.5 1.3H8a1.5 1.5 0 0 1-1.5-1.3z"
          stroke="currentColor"
          stroke-linejoin="round"
          stroke-width="1.5"
        ></path>
        <path
          d="M9 10.5V7a3 3 0 0 1 6 0v3.5"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="1.5"
        ></path>
      </svg>
      <span class="cart-button__count" data-cart-count data-count="0">
        0
      </span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-block-end: 1px solid var(--hairline);
    background-color: var(--white);
    view-transition-name: site-header;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-block-size: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: none;
  }

  .wordmark__logo {
    inline-size: 1.75rem;
    block-size: 1.75rem;
  }

  .site-nav {
    margin-inline-start: auto;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .site-nav a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--muted);
    font-size: var(--text-md);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .cart-button {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: var(--white);
    transition: border-color var(--duration) var(--ease);
  }

  .cart-button:hover {
    border-color: var(--ink);
  }

  .cart-button svg {
    inline-size: 1.375rem;
    block-size: 1.375rem;
  }

  .cart-button__count {
    position: absolute;
    inset-block-start: -0.25rem;
    inset-inline-end: -0.25rem;
    display: grid;
    place-items: center;
    min-inline-size: 1.25rem;
    block-size: 1.25rem;
    padding-inline: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--pine);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Nothing to count: no badge on an empty cart. */
  .cart-button__count[data-count="0"] {
    display: none;
  }

  /* Phones: the nav takes its own row under the wordmark and cart. The two
     rows add up to --header-height. */
  @media (max-width: 40rem) {
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: 3.5rem 2.75rem;
      gap: 0 var(--space-4);
    }

    .cart-button {
      grid-area: 1 / 2;
    }

    .site-nav {
      grid-area: 2 / 1 / 3 / -1;
      margin-inline-start: 0;
      border-block-start: 1px solid var(--hairline);
    }

    .site-nav ul {
      justify-content: space-between;
    }

    .site-nav a {
      font-size: var(--text-sm);
    }
  }
</style>
