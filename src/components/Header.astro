---
import ShoppingBag from "@lucide/astro/icons/shopping-bag";

import Logo from "../assets/logo.svg";

const links = [
  { href: "/#watches", label: "الساعات" },
  { href: "/#gifts", label: "الهدايا" },
  { href: "/#features", label: "المزايا" },
  { href: "/guides/", label: "الشروحات" },
  { href: "/#faq", label: "الأسئلة الشائعة" },
  { href: "/#contact", label: "تواصل معنا" },
] as const;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a aria-label="ساعات الحرمين، الصفحة الرئيسية" class="wordmark" href="/">
      <Logo aria-hidden="true" class="wordmark__logo" />
      <span>ساعات الحرمين</span>
    </a>

    <nav aria-label="التنقل الرئيسي" class="site-nav" id="site-nav" popover>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      aria-label="القائمة"
      class="icon-button menu-button"
      popovertarget="site-nav"
      type="button"
    >
      <svg
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="1.5"
        viewBox="0 0 24 24"
      >
        <path class="menu-button__line" d="M4.5 8h15"></path>
        <path class="menu-button__line" d="M4.5 16h15"></path>
      </svg>
    </button>

    <button
      aria-label="السلة"
      class="icon-button cart-button"
      data-cart-open
      type="button"
    >
      <ShoppingBag stroke-width={1.5} />
      <span class="cart-button__count" data-cart-count data-count="0">
        0
      </span>
    </button>
  </div>
</header>

<script>
  // A same-page link (/#watches) does not dismiss the popover by itself.
  const nav = document.querySelector<HTMLElement>("#site-nav");

  nav?.addEventListener("click", (event) => {
    if (
      event.target instanceof HTMLAnchorElement &&
      nav.matches(":popover-open")
    ) {
      nav.hidePopover();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-block-end: 1px solid var(--hairline);
    background-color: var(--white);
    view-transition-name: site-header;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-block-size: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-base);
    font-weight: 600;
    text-decoration: none;
  }

  .wordmark__logo {
    inline-size: 1.75rem;
    block-size: 1.75rem;
  }

  /* The nav is a popover so phones can fold it behind the menu button; on
     wider screens undo the popover's hidden, top-layer defaults. */
  .site-nav {
    position: static;
    display: block;
    inline-size: auto;
    block-size: auto;
    margin: 0;
    margin-inline-start: auto;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    overflow: visible;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .site-nav a {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--muted);
    font-size: var(--text-md);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .icon-button {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: var(--white);
    transition: border-color var(--duration) var(--ease);
  }

  .icon-button:hover {
    border-color: var(--ink);
  }

  .icon-button svg {
    inline-size: 1.375rem;
    block-size: 1.375rem;
  }

  .cart-button__count {
    position: absolute;
    inset-block-start: -0.25rem;
    inset-inline-end: -0.25rem;
    display: grid;
    place-items: center;
    min-inline-size: 1.25rem;
    block-size: 1.25rem;
    padding-inline: 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--pine);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Nothing to count: no badge on an empty cart. */
  .cart-button__count[data-count="0"] {
    display: none;
  }

  .menu-button {
    display: none;
  }

  /* Phones: one row of wordmark, menu and cart; the links drop down from
     under the header. */
  @media (max-width: 40rem) {
    .site-header__inner {
      gap: var(--space-3);
    }

    .menu-button {
      display: grid;
      margin-inline-start: auto;
    }

    /* Open: both lines meet in the middle and turn into an X. */
    .menu-button__line {
      transform-box: view-box;
      transform-origin: center;
      transition: transform 300ms var(--ease);
    }

    .site-header:has(.site-nav:popover-open) .menu-button__line:first-child {
      transform: rotate(45deg) translateY(4px);
    }

    .site-header:has(.site-nav:popover-open) .menu-button__line:last-child {
      transform: rotate(-45deg) translateY(-4px);
    }

    /* The dropdown fades and slides in, and back out before it hides. */
    .site-nav {
      transition:
        opacity 250ms var(--ease),
        translate 250ms var(--ease),
        display 250ms allow-discrete,
        overlay 250ms allow-discrete;
    }

    .site-nav:not(:popover-open) {
      display: none;
      opacity: 0;
      translate: 0 -0.5rem;
    }

    @starting-style {
      .site-nav:popover-open {
        opacity: 0;
        translate: 0 -0.5rem;
      }
    }

    .site-nav {
      position: fixed;
      inset: var(--header-height) 0 auto;
      inline-size: 100%;
      margin: 0;
      border-block-end: 1px solid var(--hairline);
      background-color: var(--white);
      box-shadow: 0 12px 24px -16px var(--shadow);
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
      padding-inline: var(--gutter);
      padding-block: var(--space-2);
    }

    .site-nav li + li {
      border-block-start: 1px solid var(--hairline);
    }

    .site-nav a {
      display: block;
      padding-block: var(--space-3);
      color: var(--ink);
      font-size: var(--text-base);
    }
  }
</style>
