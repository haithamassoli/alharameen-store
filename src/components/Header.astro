---
import Logo from "../assets/logo.svg";

const links = [
  { href: "/#watches", label: "الساعات" },
  { href: "/#why", label: "لماذا الحرمين" },
  { href: "/#contact", label: "تواصل معنا" },
] as const;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a aria-label="ساعات الحرمين، الصفحة الرئيسية" class="wordmark" href="/">
      <Logo aria-hidden="true" class="wordmark__logo" />
      <span>ساعات الحرمين</span>
    </a>

    <nav aria-label="التنقل الرئيسي" class="site-nav">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        aria-label="الوضع الداكن"
        aria-pressed="false"
        class="icon-button theme-toggle"
        data-theme-toggle
        title="تفعيل الوضع الداكن"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="theme-toggle__moon"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            d="M19.5 14.6A7.8 7.8 0 0 1 9.4 4.5a7.8 7.8 0 1 0 10.1 10.1z"
            stroke="currentColor"
            stroke-linejoin="round"
            stroke-width="1.5"
          ></path>
        </svg>
        <svg
          aria-hidden="true"
          class="theme-toggle__sun"
          fill="none"
          viewBox="0 0 24 24"
        >
          <circle
            cx="12"
            cy="12"
            r="4"
            stroke="currentColor"
            stroke-width="1.5"
          ></circle>
          <path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.5"
          ></path>
        </svg>
      </button>

      <button
        aria-label="السلة"
        class="icon-button cart-button"
        data-cart-open
        type="button"
      >
        <svg aria-hidden="true" fill="none" viewBox="0 0 24 24">
          <path
            d="M5.5 8.5h13l-1 11.2a1.5 1.5 0 0 1-1.5 1.3H8a1.5 1.5 0 0 1-1.5-1.3z"
            stroke="currentColor"
            stroke-linejoin="round"
            stroke-width="1.5"
          ></path>
          <path
            d="M9 10.5V7a3 3 0 0 1 6 0v3.5"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.5"
          ></path>
        </svg>
        <span class="cart-button__count" data-cart-count data-count="0">
          ٠
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    border-block-end: 1px solid var(--color-line);
    background-color: var(--color-glass);
    backdrop-filter: blur(14px) saturate(140%);
    view-transition-name: site-header;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5, 1.5rem);
    min-block-size: var(--header-height, 4.25rem);
  }

  .site-header__actions {
    display: flex;
    gap: var(--space-2, 0.5rem);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    color: var(--color-text);
    font-family: var(--font-display, serif);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-gold-strong);
  }

  .wordmark__logo {
    inline-size: 2rem;
    block-size: 2rem;
  }

  .site-nav {
    margin-inline-start: auto;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-5, 1.5rem);
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-block;
    padding-block: var(--space-2, 0.5rem);
    color: var(--color-muted);
    font-family: var(--font-display, serif);
    font-size: 1rem;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--color-gold-strong);
  }

  .icon-button {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    flex: none;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill, 999px);
    background: var(--color-tint-soft);
    color: var(--color-gold);
    transition:
      background-color var(--duration, 260ms) ease,
      border-color var(--duration, 260ms) ease;
  }

  .icon-button:hover {
    border-color: var(--color-gold);
    background-color: var(--color-tint);
  }

  .icon-button svg {
    inline-size: 1.4rem;
    block-size: 1.4rem;
  }

  .cart-button__count {
    position: absolute;
    inset-block-start: -0.3rem;
    inset-inline-end: -0.3rem;
    display: grid;
    place-items: center;
    min-inline-size: 1.35rem;
    block-size: 1.35rem;
    padding-inline: 0.3rem;
    border-radius: var(--radius-pill, 999px);
    background: var(--color-gold-fill);
    color: var(--color-on-gold);
    font-family: var(--font-display, serif);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Show the moon in day mode (it switches to night) and the sun at night. */
  .theme-toggle__sun,
  :global([data-theme="dark"]) .theme-toggle__moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: block;
  }

  /* Nothing to count: no badge on an empty cart. */
  .cart-button__count[data-count="0"] {
    display: none;
  }

  /* Narrow screens: nav drops to its own row under the wordmark and cart. */
  @media (max-width: 40rem) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: 0;
      padding-block-start: var(--space-2, 0.5rem);
    }

    .wordmark {
      margin-inline-end: auto;
    }

    .site-nav {
      order: 3;
      inline-size: 100%;
      margin-inline-start: 0;
    }

    .site-nav ul {
      justify-content: space-between;
      gap: var(--space-3, 0.75rem);
    }

    .site-nav a {
      font-size: 0.9375rem;
    }
  }
</style>

<script>
  // Day is the default; night is an opt-in stored per device. Layout's inline
  // head script applies the stored choice before first paint.
  const STORAGE_KEY = "alharameen-theme";
  const THEME_COLORS = { dark: "#08191a", light: "#fbf8f2" } as const;

  type Theme = keyof typeof THEME_COLORS;

  const root = document.documentElement;

  const currentTheme = (): Theme =>
    root.dataset.theme === "dark" ? "dark" : "light";

  const storeTheme = (theme: Theme): void => {
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      // Storage blocked (private mode): the choice lasts for this page only.
    }
  };

  const syncButton = (button: HTMLButtonElement, theme: Theme): void => {
    const isDark = theme === "dark";
    button.setAttribute("aria-pressed", String(isDark));
    button.title = isDark ? "تفعيل الوضع الفاتح" : "تفعيل الوضع الداكن";
  };

  const applyTheme = (theme: Theme): void => {
    if (theme === "dark") {
      root.dataset.theme = "dark";
    } else {
      delete root.dataset.theme;
    }

    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", THEME_COLORS[theme]);

    for (const button of document.querySelectorAll<HTMLButtonElement>(
      "[data-theme-toggle]"
    )) {
      syncButton(button, theme);
    }

    window.dispatchEvent(new CustomEvent("theme:change", { detail: theme }));
  };

  const toggleTheme = (): void => {
    const next: Theme = currentTheme() === "dark" ? "light" : "dark";
    storeTheme(next);

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // Cross-fade the whole page between palettes where supported.
    if (reduceMotion || !("startViewTransition" in document)) {
      applyTheme(next);

      return;
    }

    document.startViewTransition(() => applyTheme(next));
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]"
  )) {
    syncButton(button, currentTheme());
    button.addEventListener("click", toggleTheme);
  }
</script>
