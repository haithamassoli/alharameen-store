---
import { getCollection, getEntry } from "astro:content";

import { deliveryTime } from "../lib/delivery";
import { formatPrice } from "../lib/money";

const store = await getEntry("store", "main");

if (!store) {
  throw new Error('Missing "main" entry in the store collection');
}

const zones = await getCollection("shippingZones");
const { name, tagline, contact } = store.data;
const whatsappDigits = contact.whatsapp.replace("+", "");

const year = new Intl.NumberFormat("ar-JO", { useGrouping: false }).format(
  new Date().getFullYear()
);
---

<footer class="site-footer" id="contact">
  <div class="site-footer__grid container">
    <div class="site-footer__brand">
      <p class="site-footer__name">{name}</p>
      <p class="site-footer__tagline">{tagline}</p>
    </div>

    <section aria-labelledby="footer-contact" class="site-footer__block">
      <h2 id="footer-contact">اطلب عبر واتساب</h2>
      <a
        class="whatsapp-link"
        href={`https://wa.me/${whatsappDigits}`}
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Zm0 1.6a7.4 7.4 0 1 1-3.8 13.8l-.3-.2-2.7.7.7-2.6-.2-.3A7.4 7.4 0 0 1 12 4.6Zm-3 3.3c-.2 0-.5 0-.7.3-.3.3-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 1.9 3 4.7 4.1 2.3.9 2.8.7 3.3.7.5-.1 1.6-.7 1.8-1.3.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3l-1.9-.9c-.3-.1-.5-.2-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.8-.8-1.4-1.7-1.5-2-.2-.3 0-.4.1-.6l.4-.5.3-.5v-.5l-.9-2.1c-.2-.5-.4-.5-.6-.5H9Z"></path>
        </svg>
        <span class="visually-hidden">واتساب:</span>
        <bdi dir="ltr">{contact.whatsapp}</bdi>
        <span class="visually-hidden">(يفتح في نافذة جديدة)</span>
      </a>
      <p class="site-footer__note">
        الدفع نقدًا عند الاستلام، أو نتفق عليه في المحادثة.
      </p>
    </section>

    <section aria-labelledby="footer-delivery" class="site-footer__block">
      <h2 id="footer-delivery">التوصيل</h2>
      <dl class="delivery-list">
        {zones.map((zone) => (
          <div>
            <dt>{zone.data.name}</dt>
            <dd>
              {formatPrice(zone.data.fee, zone.data.currency)}
              <span>
                يصلك {deliveryTime(zone.data.minDays, zone.data.maxDays)}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    </section>
  </div>

  <div class="site-footer__legal container">
    <small>
      © {year} {name}. {contact.address}
    </small>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-7, 3rem);
    padding-block: var(--space-8, 4.5rem) var(--space-6, 2rem);
    border-block-start: 1px solid var(--color-line);
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-bg-deep) 40%
    );
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-7, 3rem);
  }

  .site-footer__name {
    color: var(--color-gold);
    font-family: var(--font-display, serif);
    font-size: var(--text-xl, 1.5625rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .site-footer__tagline,
  .site-footer__note {
    margin-block-start: var(--space-3, 0.75rem);
    color: var(--color-muted);
    font-size: var(--text-sm, 0.875rem);
  }

  .site-footer__block h2 {
    margin-block-end: var(--space-4, 1rem);
    font-size: var(--text-lg, 1.25rem);
  }

  .whatsapp-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    min-block-size: 2.75rem;
    font-family: var(--font-display, serif);
    font-size: var(--text-lg, 1.25rem);
    text-decoration: none;
  }

  .whatsapp-link svg {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    fill: currentcolor;
  }

  .delivery-list {
    display: grid;
    gap: var(--space-3, 0.75rem);
  }

  .delivery-list div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2, 0.5rem);
    padding-block-end: var(--space-3, 0.75rem);
    border-block-end: 1px dashed var(--color-line);
  }

  .delivery-list dt {
    font-family: var(--font-display, serif);
  }

  .delivery-list dd {
    margin: 0;
    color: var(--color-gold);
  }

  .delivery-list dd span {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm, 0.875rem);
  }

  .site-footer__legal {
    margin-block-start: var(--space-7, 3rem);
    padding-block-start: var(--space-5, 1.5rem);
    border-block-start: 1px solid var(--color-line);
    color: var(--color-muted);
  }
</style>
