---
import { siFacebook, siInstagram, siWhatsapp } from "simple-icons";

import Logo from "../assets/logo.svg";
import { getStore } from "../lib/store";

const { name, tagline, contact } = await getStore();

const socials = [
  {
    href: contact.facebook,
    label: "فيسبوك",
    path: siFacebook.path,
  },
  {
    href: contact.instagram,
    label: "إنستغرام",
    path: siInstagram.path,
  },
  {
    href: `https://wa.me/${contact.whatsapp.replace("+", "")}`,
    label: "واتساب",
    path: siWhatsapp.path,
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__grid container">
    <div class="site-footer__brand">
      <p class="site-footer__name">
        <Logo aria-hidden="true" class="site-footer__logo" />
        {name}
      </p>
      <p class="site-footer__tagline">{tagline}</p>
    </div>

    <ul aria-label="تابعنا" class="social" role="list">
      {socials.map(({ label, href, path }) => (
        <li>
          <a href={href} rel="noopener noreferrer" target="_blank">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d={path} />
            </svg>
            <span class="visually-hidden">{label} (يفتح في نافذة جديدة)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="site-footer__legal container">
    <small>
      © {year} {name}، {contact.address}
    </small>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 6vw, 4.5rem) var(--space-6);
    border-block-start: 1px solid var(--hairline);
    background: var(--white);
    color: var(--muted);
    font-size: var(--text-md);
  }

  .site-footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6) var(--space-7);
  }

  .site-footer__name {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .site-footer__logo {
    inline-size: 1.75rem;
    block-size: 1.75rem;
    flex: none;
  }

  .site-footer__tagline {
    margin-block-start: var(--space-2);
  }

  .social {
    display: flex;
    gap: var(--space-3);
    align-self: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    color: var(--ink);
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .social a:hover {
    border-color: var(--pine);
    background: var(--pine);
    color: var(--white);
  }

  .social svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    fill: currentcolor;
  }

  .site-footer__legal {
    margin-block-start: var(--space-7);
  }

  .site-footer__legal small {
    display: block;
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--hairline);
  }
</style>
