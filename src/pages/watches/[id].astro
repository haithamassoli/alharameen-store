---
import type { GetStaticPaths } from "astro";
import { getImage, Image, Picture } from "astro:assets";
import { getCollection, getEntry } from "astro:content";

import ProductCard from "../../components/ProductCard.astro";
import VideoGrid from "../../components/VideoGrid.astro";
import Layout from "../../layouts/Layout.astro";
import { whatsappUrl } from "../../lib/cart";
import { formatPrice, toDecimalString } from "../../lib/money";
import { getGuideFor, getShippingZones, getStore } from "../../lib/store";

export const getStaticPaths = (async () => {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { id, data } = product;
const [variant] = data.variants;

const store = await getStore();
const category = await getEntry(data.category);

if (!category) {
  throw new Error(`Missing category for product "${id}"`);
}

const categories = await getCollection("categories");

const categoryNames = new Map(
  categories.map((entry) => [entry.id, entry.data.name])
);

const allProducts = await getCollection("products");

const others = allProducts
  .filter((entry) => entry.id !== id)
  .toSorted(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      a.data.price - b.data.price
  );

const zones = await getShippingZones();
const guide = await getGuideFor(data.model);

const LOW_STOCK = 5;
const MAIN_SIZE = 720;
const THUMB_SIZE = 120;

// The rest of the family's videos live on /guides/.
const GUIDE_PREVIEW = 6;

const digits = new Intl.NumberFormat("ar-JO-u-nu-latn");
const price = formatPrice(data.price, data.currency);
const inStock = variant.stock > 0;
const isLowStock = inStock && variant.stock <= LOW_STOCK;

const lowStockText = (stock: number): string => {
  if (stock === 1) {
    return "متوفر، بقيت قطعة واحدة فقط";
  }

  if (stock === 2) {
    return "متوفر، بقيت قطعتان فقط";
  }

  return `متوفر، بقي ${digits.format(stock)} قطع فقط`;
};

const orderMessage = [
  "السلام عليكم، أرغب بطلب:",
  `${data.name} (${data.model})`,
  `السعر: ${price}`,
  `الكمية: ${digits.format(1)}`,
  "",
  "أرجو تأكيد الطلب وتفاصيل التوصيل.",
].join("\n");

const orderUrl = whatsappUrl(store.contact.whatsapp, orderMessage);

// Source photos are transparent cutouts; link-preview bots and Google get
// them as JPEG on the old studio white.
const toShareImage = (src: ImageMetadata) =>
  getImage({ background: "#ffffff", format: "jpeg", src });

const [mainImage] = data.images;

const shareImages = await Promise.all(
  data.images.map((image) => toShareImage(image.src))
);

const mainShare = await toShareImage(mainImage.src);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  brand: { "@type": "Brand", name: "Al-Harameen" },
  category: category.data.name,
  description: data.description,
  image: shareImages.map((image) => new URL(image.src, Astro.site).href),
  model: data.model,
  name: data.name,
  offers: {
    "@type": "Offer",
    availability: inStock
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: "JO",
      merchantReturnDays: store.returnDays,
      returnPolicyCategory:
        "https://schema.org/MerchantReturnFiniteReturnWindow",
    },
    itemCondition: "https://schema.org/NewCondition",
    price: toDecimalString(data.price, data.currency),
    priceCurrency: data.currency,
    seller: { "@type": "Organization", name: store.name },
    url: pageUrl,
  },
  sku: variant.sku,
};
---

<Layout
  description={data.description}
  image={{
    alt: mainImage.alt,
    height: mainImage.src.height,
    src: mainShare.src,
    width: mainImage.src.width,
  }}
  jsonLd={productJsonLd}
  title={data.name}
>
  <main class="product container" id="main">
    <a class="back-link" href="/#watches">
      <svg aria-hidden="true" fill="none" viewBox="0 0 24 24">
        <path
          d="m9 6 6 6-6 6"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
        ></path>
      </svg>
      العودة إلى كل الساعات
    </a>

    <div class="product__top">
      <div class="gallery">
        <div
          class="gallery__main"
          style={`view-transition-name: product-${id}-image`}
        >
          {data.images.map((image, index) => (
            <div class="gallery__slide">
              <Picture
                alt={image.alt}
                class="gallery__image"
                fetchpriority={index === 0 ? "high" : "auto"}
                formats={["avif", "webp"]}
                height={MAIN_SIZE}
                loading={index === 0 ? "eager" : "lazy"}
                sizes="(min-width: 56rem) 34rem, 92vw"
                src={image.src}
                width={MAIN_SIZE}
                widths={[360, 540, MAIN_SIZE]}
              />
            </div>
          ))}
        </div>

        {data.images.length > 1 && (
          <fieldset class="gallery__thumbs">
            <legend class="visually-hidden">اختر صورة لعرضها</legend>
            {data.images.map((image, index) => (
              <label class="gallery__thumb">
                <input
                  checked={index === 0}
                  class="visually-hidden"
                  name="gallery"
                  type="radio"
                  value={index}
                />
                <Image
                  alt={`الصورة ${digits.format(index + 1)}: ${image.alt}`}
                  format="webp"
                  height={THUMB_SIZE}
                  src={image.src}
                  width={THUMB_SIZE}
                />
              </label>
            ))}
          </fieldset>
        )}
      </div>

      <div class="summary">
        <p class="summary__category">{category.data.name}</p>
        <h1
          class="summary__name"
          style={`view-transition-name: product-${id}-name`}
        >
          {data.name}
        </h1>
        <p class="summary__model">
          رقم الموديل: <span dir="ltr">{data.model}</span>
        </p>

        <p class="summary__price price">
          <span class="visually-hidden">السعر:</span>
          {price}
        </p>

        <dl class="summary__facts">
          {variant.color && (
            <div>
              <dt>اللون</dt>
              <dd>{variant.color}</dd>
            </div>
          )}
          <div>
            <dt>التوفر</dt>
            <dd
              class:list={[
                "stock",
                { "stock--low": isLowStock, "stock--out": !inStock },
              ]}
            >
              {!inStock && "نفدت الكمية حاليًا"}
              {isLowStock && lowStockText(variant.stock)}
              {inStock && !isLowStock && "متوفر وجاهز للتوصيل"}
            </dd>
          </div>
        </dl>

        <div class="summary__actions">
          <button
            class="btn btn-primary"
            data-add-to-cart={id}
            disabled={!inStock}
            type="button"
          >
            أضف إلى السلة
          </button>
          <a
            class="btn btn-ghost"
            href={orderUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            اطلب مباشرة عبر واتساب
            <span class="visually-hidden">(يفتح في نافذة جديدة)</span>
          </a>
        </div>

        <ul class="summary__delivery">
          {zones.map(({ data: zone }) => (
            <li>
              التوصيل {zone.name}: {formatPrice(zone.fee, zone.currency)}
            </li>
          ))}
          <li>الدفع نقدًا عند الاستلام</li>
        </ul>

        <p class="summary__description">{data.description}</p>
      </div>
    </div>

    <div class="details band">
      <section aria-labelledby="features-title" class="details__block">
        <h2 id="features-title">المزايا</h2>
        <ul class="feature-list">
          {data.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="specs-title" class="details__block">
        <h2 id="specs-title">المواصفات</h2>
        <table aria-labelledby="specs-title" class="specs">
          <tbody>
            <tr>
              <th scope="row">رقم الموديل</th>
              <td dir="ltr">{data.model}</td>
            </tr>
            {Object.entries(data.specs).map(([label, value]) => (
              <tr>
                <th scope="row">{label}</th>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    </div>

    {guide && (
      <section aria-labelledby="guide-title" class="guide band">
        <div class="section-head">
          <div>
            <h2 id="guide-title">طريقة الاستعمال</h2>
            <p class="section-note">
              فيديوهات رسمية من الحرمين لضبط الوقت والمدينة والأذان.
            </p>
          </div>
          {guide.data.videos.length > GUIDE_PREVIEW && (
            <a class="btn btn-ghost" href={`/guides/#${guide.id}`}>
              {`كل شروحات ${guide.data.name} (${digits.format(guide.data.videos.length)} فيديو)`}
            </a>
          )}
        </div>
        <VideoGrid videos={guide.data.videos.slice(0, GUIDE_PREVIEW)} />
      </section>
    )}

    <section aria-labelledby="more-title" class="more band">
      <h2 class="more__title" id="more-title">
        ساعات أخرى قد تعجبك
      </h2>
      <ul class="more__strip">
        {others.map((other) => (
          <li>
            <ProductCard
              categoryName={categoryNames.get(other.data.category.id) ?? ""}
              product={other}
            />
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .product {
    padding-block: var(--space-5) var(--section);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-block-end: var(--space-5);
    padding-block: var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .back-link:hover {
    color: var(--ink);
  }

  /* The chevron points "back", which is the inline-start side in RTL. */
  .back-link svg {
    inline-size: 1.1em;
    block-size: 1.1em;
  }

  .back-link:dir(ltr) svg {
    scale: -1 1;
  }

  .product__top {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 56rem) {
    .product__top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .gallery {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-5));
    }
  }

  /* ---------- Gallery (CSS only: the checked radio picks the slide) ---------- */

  .gallery {
    display: grid;
    gap: var(--space-3);
  }

  .gallery__main {
    display: grid;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--chalk);
  }

  .gallery__slide {
    display: grid;
  }

  .gallery__slide + .gallery__slide {
    display: none;
  }

  /* White studio photos melt into the chalk ground. */
  .gallery__image {
    inline-size: 100%;
    block-size: 100%;
    padding: 6%;
    object-fit: contain;
  }

  .gallery:has(.gallery__thumb:nth-of-type(2) input:checked) .gallery__slide,
  .gallery:has(.gallery__thumb:nth-of-type(3) input:checked) .gallery__slide,
  .gallery:has(.gallery__thumb:nth-of-type(4) input:checked) .gallery__slide {
    display: none;
  }

  .gallery:has(.gallery__thumb:nth-of-type(2) input:checked)
    .gallery__slide:nth-child(2),
  .gallery:has(.gallery__thumb:nth-of-type(3) input:checked)
    .gallery__slide:nth-child(3),
  .gallery:has(.gallery__thumb:nth-of-type(4) input:checked)
    .gallery__slide:nth-child(4) {
    display: grid;
  }

  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    border: 0;
  }

  .gallery__thumb {
    overflow: hidden;
    inline-size: 4.5rem;
    border: 1px solid var(--hairline);
    background: var(--chalk);
    cursor: pointer;
    transition: border-color var(--duration) var(--ease);
  }

  .gallery__thumb:hover {
    border-color: var(--line-strong);
  }

  .gallery__thumb:has(input:checked) {
    border-color: var(--ink);
  }

  .gallery__thumb:has(input:focus-visible) {
    outline: 2px solid var(--pine);
    outline-offset: 3px;
  }

  /* ---------- Summary ---------- */

  .summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .summary__category {
    color: var(--pine);
    font-size: var(--text-md);
    font-weight: 500;
  }

  .summary__name {
    inline-size: fit-content;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .summary__model {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .summary__model span {
    color: var(--ink);
    font-weight: 500;
    letter-spacing: 0.02em;
    unicode-bidi: isolate;
  }

  .summary__price {
    margin-block: var(--space-2);
    font-size: clamp(1.625rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .summary__facts {
    border-block-start: 1px solid var(--ink);
  }

  .summary__facts div {
    display: flex;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--hairline);
  }

  .summary__facts dt {
    min-inline-size: 5rem;
    color: var(--muted);
  }

  .summary__facts dd {
    margin: 0;
  }

  .stock {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .stock::before {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--pine);
    content: "";
  }

  .stock--low::before {
    background: var(--danger);
  }

  .stock--out::before {
    background: var(--muted);
  }

  .summary__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }

  .summary__actions .btn {
    flex: 1 1 14rem;
  }

  .summary__delivery {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Below the purchase actions, so they stay in the first screen on phones. */
  .summary__description {
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--hairline);
    color: var(--muted);
  }

  /* ---------- Details ---------- */

  .band {
    margin-block-start: var(--section);
  }

  .details {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 56rem) {
    .details {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 6rem);
    }
  }

  .details__block h2 {
    margin-block-end: var(--space-4);
    font-size: var(--text-lg);
  }

  .feature-list {
    border-block-start: 1px solid var(--ink);
  }

  .feature-list li {
    position: relative;
    padding-block: var(--space-3);
    padding-inline-start: var(--space-5);
    border-block-end: 1px solid var(--hairline);
  }

  .feature-list li::before {
    position: absolute;
    inset-block-start: calc(var(--space-3) + 0.75em);
    inset-inline-start: 0.125rem;
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 50%;
    background: var(--pine);
    content: "";
  }

  .specs {
    inline-size: 100%;
    border-collapse: collapse;
    border-block-start: 1px solid var(--ink);
  }

  .specs th,
  .specs td {
    padding-block: var(--space-3);
    padding-inline: 0 var(--space-4);
    border-block-end: 1px solid var(--hairline);
    text-align: start;
    vertical-align: baseline;
  }

  .specs th {
    inline-size: 40%;
    color: var(--muted);
    font-weight: 400;
  }

  /* ---------- How-to videos and more watches ---------- */

  .guide,
  .more {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--hairline);
  }

  .more__title {
    margin-block-end: clamp(1.75rem, 3vw, 2.5rem);
  }

  .more__strip {
    display: grid;
    grid-auto-columns: minmax(14rem, 17rem);
    grid-auto-flow: column;
    gap: var(--space-5);
    /* Bleed into the container gutter so cards scroll edge to edge;
       the gutter only reappears as padding at either end of the strip. */
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    padding-block-end: var(--space-5);
    scroll-padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    scrollbar-width: thin;
  }

  .more__strip > li {
    scroll-snap-align: start;
  }
</style>
