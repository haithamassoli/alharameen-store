---
// Style exploration /4 «الشاشة»: the unlit daylight LCD of an Al-Harameen
// watch scaled up to a page. Seven-segment readouts with ghost segments, and
// a pinned hero screen that cycles وقت → أذان → هجري → قبلة as you scroll.
import "@fontsource-variable/kufam/wght.css";
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/500.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import "@fontsource/ibm-plex-sans-arabic/700.css";
import { Picture } from "astro:assets";

import { deliveryTime } from "../lib/delivery";
import { getHomeData } from "../lib/home-data";
import { formatPrice } from "../lib/money";
import { QIBLA_BEARING_AMMAN, hijriDate, lcdMarkup } from "../lib/style-4";

const {
  store,
  products,
  categoryName,
  zones,
  warranty,
  chatUrl,
  digits,
  features,
  steps,
} = await getHomeData();

const [firstProduct] = products;

const featured =
  products.find((product) => product.data.featured) ?? firstProduct;

const [featuredCover] = featured.data.images;
const [cheapestZone] = zones;
const { contact } = store;

// Server sample for the clock; the page script replaces it with Amman time.
const SAMPLE_TIME = "10:08";
const SAMPLE_SECONDS = "36";
const hijri = hijriDate(new Date());

const PRAYERS = ["الفجر", "الظهر", "العصر", "المغرب", "العشاء"] as const;
const NEXT_PRAYER = "العصر";

const MODES = ["وقت", "أذان", "هجري", "قبلة"] as const;

const FEATURE_MODES = new Map([
  ["azan", "أذان"],
  ["qibla", "قبلة"],
  ["calendar", "هجري"],
  ["shield", "ضمان"],
  ["truck", "توصيل"],
]);

const SPEC_ROWS = 3;
const TICK_COUNT = 24;
const TICK_STEP = 360 / TICK_COUNT;
const CARDINAL_EVERY = 6;

const ticks = Array.from({ length: TICK_COUNT }, (_, index) => ({
  angle: index * TICK_STEP,
  isCardinal: index % CARDINAL_EVERY === 0,
  isQibla: index === Math.round(QIBLA_BEARING_AMMAN / TICK_STEP),
}));

const twoCells = (count: number): string => String(count).padStart(2, "0");

const year = new Intl.NumberFormat("ar-JO", { useGrouping: false }).format(
  new Date().getFullYear()
);
---

<!doctype html>
<html dir="rtl" lang="ar">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="noindex" name="robots" />
    <meta content="light" name="color-scheme" />
    <meta content="#F4F5F0" name="theme-color" />
    <meta content={store.tagline} name="description" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <title>{store.name}: الشاشة</title>
  </head>
  <body>
    <a class="skip" href="#main">
      انتقل إلى المحتوى
    </a>

    <header class="top">
      <div class="top__inner wrap">
        <a class="brand" href="/4">
          <span aria-hidden="true" class="brand__mark"></span>
          {store.name}
        </a>
        <nav aria-label="أقسام الصفحة" class="top__nav">
          <a class="top__link" href="#watches">
            الساعات
          </a>
          <a class="top__link" href="#features">
            المزايا
          </a>
          <a class="top__link" href="#order">
            طريقة الطلب
          </a>
          <a
            class="top__chat"
            href={chatUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            واتساب
            <span class="vh">(يفتح في نافذة جديدة)</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section aria-labelledby="hero-title" class="hero">
        <div class="hero__intro">
          <div class="hero__copy">
            <h1 class="hero__title" id="hero-title">
              لا يفوتك أذان،
              <span class="hero__title-line">أينما كنت</span>
            </h1>
            <p class="hero__lead">
              ساعات الحرمين الأصلية تنبّهك لكل صلاة، وتدلّك على القبلة، وتعرض
              التاريخ الهجري على شاشة واحدة. اطلب ساعتك عبر واتساب ونوصلها إلى
              باب بيتك في الأردن.
            </p>
            <div class="hero__actions">
              <a class="btn btn--ink" href="#watches">
                تصفّح الساعات
              </a>
              <a
                class="btn btn--line"
                href={chatUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                اطلب عبر واتساب
                <span class="vh">(يفتح في نافذة جديدة)</span>
              </a>
            </div>
            <ul class="hero__facts">
              <li>الدفع نقدًا عند الاستلام</li>
              <li>ضمان {warranty}</li>
              {cheapestZone && (
                <li>
                  توصيل {cheapestZone.data.name}{" "}
                  {formatPrice(
                    cheapestZone.data.fee,
                    cheapestZone.data.currency
                  )}
                </li>
              )}
            </ul>
          </div>
        </div>

        <div class="hero__track">
          <div class="hero__stage">
            <div class="screen">
              <ol aria-hidden="true" class="screen__modes">
                {MODES.map((mode) => (
                  <li class="screen__mode">{mode}</li>
                ))}
              </ol>

              <div class="screen__glass">
                <div class="panel panel--time">
                  <p class="panel__mode">الوقت</p>
                  <div class="panel__readout" dir="ltr">
                    <span aria-hidden="true" class="panel__period" data-period>
                      ص
                    </span>
                    <span
                      aria-hidden="true"
                      class="lcd lcd--xl"
                      data-lcd="time"
                      set:html={lcdMarkup(SAMPLE_TIME)}
                    />
                    <span
                      aria-hidden="true"
                      class="lcd lcd--sm"
                      data-lcd="seconds"
                      set:html={lcdMarkup(SAMPLE_SECONDS)}
                    />
                  </div>
                  <p class="panel__caption">
                    <span data-clock-caption>مثال على شاشة الوقت</span>
                    <span class="vh" data-clock-spoken>
                      الساعة ١٠:٠٨ صباحًا
                    </span>
                  </p>
                </div>

                <div class="panel panel--azan">
                  <p class="panel__mode">الأذان القادم</p>
                  <ul class="prayers">
                    {PRAYERS.map((prayer) => (
                      <li
                        class:list={[
                          "prayers__item",
                          prayer === NEXT_PRAYER && "is-next",
                        ]}
                      >
                        {prayer}
                      </li>
                    ))}
                  </ul>
                  <div class="panel__readout" dir="ltr">
                    <svg
                      aria-hidden="true"
                      class="bell"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20.5a2 2 0 0 0 4 0"></path>
                      <path d="M3 7.5a9 9 0 0 1 2.5-4M21 7.5a9 9 0 0 0-2.5-4"></path>
                    </svg>
                    <span
                      aria-hidden="true"
                      class="lcd lcd--xl"
                      set:html={lcdMarkup(" 3:12")}
                    />
                  </div>
                  <p class="panel__caption">
                    مثال: أذان العصر الساعة ٣:١٢، والمنبّه يرنّ معه
                  </p>
                </div>

                <div class="panel panel--hijri">
                  <p class="panel__mode">التاريخ الهجري</p>
                  <div class="panel__readout panel__readout--date">
                    <span
                      aria-hidden="true"
                      class="lcd lcd--xl"
                      data-lcd="hijri-day"
                      dir="ltr"
                      set:html={lcdMarkup(hijri.day)}
                    />
                    <span aria-hidden="true" class="hijri">
                      <span class="hijri__month" data-hijri-month>
                        {hijri.month}
                      </span>
                      <span class="hijri__year" data-hijri-year>
                        {hijri.year}
                      </span>
                    </span>
                  </div>
                  <p class="panel__caption">
                    <span class="vh" data-hijri-spoken>
                      {hijri.spoken}
                    </span>
                    <span aria-hidden="true" data-hijri-weekday>
                      {hijri.weekday}
                    </span>
                    ، حسب تقويم أم القرى
                  </p>
                </div>

                <div class="panel panel--qibla">
                  <p class="panel__mode">القبلة</p>
                  <div class="panel__readout" dir="ltr">
                    <svg
                      aria-hidden="true"
                      class="compass"
                      viewBox="0 0 120 120"
                    >
                      {ticks.map((tick) => (
                        <rect
                          class:list={[
                            "compass__tick",
                            tick.isCardinal && "is-cardinal",
                            tick.isQibla && "is-qibla",
                          ]}
                          height={tick.isCardinal ? 10 : 7}
                          transform={`rotate(${tick.angle} 60 60)`}
                          width="3"
                          x="58.5"
                          y="3"
                        />
                      ))}
                      <text class="compass__north" x="60" y="29">
                        ش
                      </text>
                      <g
                        class="compass__needle"
                        style={`--bearing: ${QIBLA_BEARING_AMMAN}deg`}
                      >
                        <polygon
                          class="compass__tail"
                          points="60,64 64.5,68.5 64.5,88 60,92.5 55.5,88 55.5,68.5"
                        ></polygon>
                        <polygon
                          class="compass__pointer"
                          points="60,17 65,22 65,51.5 60,56 55,51.5 55,22"
                        ></polygon>
                        <circle
                          class="compass__hub"
                          cx="60"
                          cy="60"
                          r="3.5"
                        ></circle>
                      </g>
                    </svg>
                    <span
                      aria-hidden="true"
                      class="lcd lcd--lg"
                      set:html={lcdMarkup(`${QIBLA_BEARING_AMMAN}°`)}
                    />
                  </div>
                  <p class="panel__caption">
                    {`مثال: القبلة من عمّان على ${digits.format(QIBLA_BEARING_AMMAN)} درجة من الشمال`}
                  </p>
                </div>
              </div>

              <p class="screen__hint">مرّر للأسفل لتبديل وضع الشاشة</p>
            </div>

            <figure class="hero__watch">
              <Picture
                alt={featuredCover.alt}
                class="hero__photo"
                fetchpriority="high"
                formats={["avif", "webp"]}
                height={640}
                loading="eager"
                sizes="(min-width: 64rem) 17rem, 45vw"
                src={featuredCover.src}
                widths={[240, 400, 640]}
                width={640}
              />
              <figcaption class="hero__watch-caption">
                <a href={`/watches/${featured.id}/`}>{featured.data.name}</a>
                <span>
                  {formatPrice(featured.data.price, featured.data.currency)}
                </span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section aria-labelledby="watches-title" class="section" id="watches">
        <div class="wrap">
          <div class="section__head">
            <div>
              <h2 class="section__title" id="watches-title">
                الساعات
              </h2>
              <p class="section__lead">
                {digits.format(products.length)} قطع أصلية، كل واحدة مجرّبة قبل
                الشحن. افتح أي ساعة لترى مواصفاتها كاملة.
              </p>
            </div>
            <span
              aria-hidden="true"
              class="lcd lcd--counter lcd--view"
              dir="ltr"
              set:html={lcdMarkup(twoCells(products.length))}
            />
          </div>

          <ul class="catalog">
            {products.map((product, index) => {
              const { data } = product;
              const [cover] = data.images;
              const isLead = index === 0;
              const specRows = Object.entries(data.specs).slice(0, SPEC_ROWS);

              return (
                <li class:list={["tile", isLead && "tile--lead"]}>
                  <div class="tile__bezel">
                    <Picture
                      alt={cover.alt}
                      class="tile__photo"
                      formats={["avif", "webp"]}
                      height={480}
                      loading="lazy"
                      sizes={
                        isLead
                          ? "(min-width: 64rem) 22rem, 40vw"
                          : "(min-width: 64rem) 18rem, 40vw"
                      }
                      src={cover.src}
                      widths={[240, 360, 480]}
                      width={480}
                    />
                  </div>
                  <div class="tile__body">
                    <p class="tile__meta">
                      <span>{categoryName(product)}</span>
                      <span class="tile__model" dir="ltr">
                        {data.model}
                      </span>
                    </p>
                    <h3 class="tile__name">{data.name}</h3>
                    {isLead && (
                      <dl class="specs">
                        {specRows.map(([label, value]) => (
                          <div class="specs__row">
                            <dt>{label}</dt>
                            <dd>{value}</dd>
                          </div>
                        ))}
                      </dl>
                    )}
                    <p class="tile__price">
                      <span class="vh">السعر:</span>
                      <span class="tile__amount">
                        {formatPrice(data.price, data.currency)}
                      </span>
                      {data.compareAtPrice && (
                        <s class="tile__was">
                          <span class="vh">بدلًا من</span>
                          {formatPrice(data.compareAtPrice, data.currency)}
                        </s>
                      )}
                    </p>
                    <a class="tile__link" href={`/watches/${product.id}/`}>
                      التفاصيل
                      <span class="vh"> عن {data.name}</span>
                    </a>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <section aria-labelledby="features-title" class="section" id="features">
        <div class="wrap split">
          <div class="section__head section__head--stack">
            <h2 class="section__title" id="features-title">
              ما الذي تقدّمه لك الساعة
            </h2>
            <p class="section__lead">
              كل ميزة وضعٌ على الشاشة تصل إليه بضغطة زر، مثل قائمة الساعة نفسها.
            </p>
          </div>
          <ul class="menu">
            {features.map((feature) => (
              <li class="menu__row">
                <span class="menu__mode">
                  {FEATURE_MODES.get(feature.icon) ?? feature.title}
                </span>
                <span aria-hidden="true" class="menu__caret"></span>
                <div class="menu__item">
                  <h3 class="menu__title">{feature.title}</h3>
                  <p class="menu__text">{feature.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section aria-labelledby="order-title" class="section" id="order">
        <div class="wrap">
          <div class="section__head">
            <h2 class="section__title" id="order-title">
              ثلاث خطوات وتصلك ساعتك
            </h2>
          </div>
          <div class="order">
            <ol class="steps">
              {steps.map((step, index) => (
                <li class="step">
                  <span
                    aria-hidden="true"
                    class="lcd lcd--step lcd--view"
                    dir="ltr"
                    set:html={lcdMarkup(String(index + 1))}
                  />
                  <div>
                    <h3 class="step__title">
                      <span class="vh">{digits.format(index + 1)}. </span>
                      {step.title}
                    </h3>
                    <p class="step__text">{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>

            <div class="delivery">
              <h3 class="delivery__title">رسوم التوصيل</h3>
              <ul class="delivery__list">
                {zones.map(({ data }) => (
                  <li class="delivery__row">
                    <span class="delivery__zone">{data.name}</span>
                    <span aria-hidden="true" class="delivery__leader"></span>
                    <span class="delivery__fee">
                      {formatPrice(data.fee, data.currency)}
                    </span>
                    <span class="delivery__time">
                      يصلك {deliveryTime(data.minDays, data.maxDays)}
                    </span>
                  </li>
                ))}
              </ul>
              <p class="delivery__cash">
                <span aria-hidden="true" class="delivery__led"></span>
                الدفع نقدًا عند الاستلام
              </p>
            </div>
          </div>
        </div>
      </section>

      <section aria-labelledby="cta-title" class="section">
        <div class="wrap">
          <div class="cta">
            <div class="cta__copy">
              <h2 class="section__title" id="cta-title">
                جاهز تطلب ساعتك؟
              </h2>
              <p class="section__lead">
                راسلنا على واتساب لأي سؤال عن الساعات أو التوصيل، ونرد عليك
                بأسرع وقت.
              </p>
            </div>
            <div class="cta__actions">
              <a
                class="btn btn--ink btn--big"
                href={chatUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                تواصل معنا عبر واتساب
                <span class="vh">(يفتح في نافذة جديدة)</span>
              </a>
              <p class="cta__phone">
                أو اتصل بنا:
                <a dir="ltr" href={`tel:${contact.phone}`}>
                  {contact.phone}
                </a>
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="foot__inner wrap">
        <p class="foot__name">{store.name}</p>
        <p>{contact.address}</p>
        <p>© {year}</p>
      </div>
    </footer>

    <script>
      import { ammanTime, hijriDate } from "../lib/style-4";

      const SECOND_MS = 1000;

      const setCells = (selector: string, value: string): void => {
        const cells = document.querySelectorAll<SVGElement>(
          `${selector} [data-d]`
        );

        const chars = [...value];

        for (const [index, cell] of cells.entries()) {
          const next = (chars[index] ?? "").trim();

          if (cell.dataset.d !== next) {
            cell.dataset.d = next;
          }
        }
      };

      const setText = (selector: string, text: string): void => {
        for (const node of document.querySelectorAll(selector)) {
          if (node.textContent !== text) {
            node.textContent = text;
          }
        }
      };

      const showHijri = (): void => {
        const today = hijriDate(new Date());
        setCells('[data-lcd="hijri-day"]', today.day);
        setText("[data-hijri-month]", today.month);
        setText("[data-hijri-year]", today.year);
        setText("[data-hijri-weekday]", today.weekday);
        setText("[data-hijri-spoken]", today.spoken);
      };

      const tick = (): void => {
        const now = ammanTime(new Date());
        setCells('[data-lcd="time"]', now.digits);
        setCells('[data-lcd="seconds"]', now.seconds);
        setText("[data-period]", now.period);
        setText("[data-clock-caption]", "الوقت الآن في عمّان");
        setText("[data-clock-spoken]", `الساعة ${now.spoken} في عمّان`);
        window.setTimeout(tick, SECOND_MS - (Date.now() % SECOND_MS));
      };

      showHijri();

      tick();
    </script>
  </body>
</html>

<style is:global>
  @property --on {
    syntax: "<number>";
    inherits: true;
    initial-value: 1;
  }

  :root {
    color-scheme: light;

    --glass: #f4f5f0;
    --bezel: #e4e2da;
    --bezel-deep: #d3d0c5;
    --tint: #e9ede3;
    --ink: #14241c;
    --muted: #4b5a51;
    --ghost: #d5d9cf;
    --lit: #1b3d30;
    --amber: #b5651d;
    --line: rgb(20 36 28 / 0.14);

    --font-display:
      "Kufam Variable", "IBM Plex Sans Arabic", system-ui, sans-serif;
    --font-body: "IBM Plex Sans Arabic", system-ui, sans-serif;

    --step--1: 0.8125rem;
    --step-0: 1.0625rem;
    --step-1: 1.3125rem;
    --step-2: clamp(1.75rem, 1.4rem + 1.2vw, 2.375rem);
    --step-3: clamp(2.25rem, 1.6rem + 1.9vw, 3.25rem);

    --radius-screen: 1.75rem;
    --radius-glass: 1.125rem;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--glass);
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    overflow-x: clip;
    background: var(--glass);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--step-0);
    line-height: 1.7;
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol,
  dl,
  dd,
  figure {
    margin: 0;
  }

  ul,
  ol {
    padding: 0;
    list-style: none;
  }

  img {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 3px solid var(--lit);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .vh {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .skip {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 0.5rem;
    z-index: 10;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: var(--lit);
    color: var(--glass);
    translate: 0 -200%;
  }

  .skip:focus-visible {
    translate: 0 0;
  }

  .wrap {
    inline-size: 100%;
    max-inline-size: 78rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media (min-width: 48rem) {
    .wrap {
      padding-inline: 2rem;
    }
  }

  /* ---------- Seven-segment cells ---------- */

  .lcd {
    --h: 3rem;
    display: inline-flex;
    align-items: flex-end;
    gap: calc(var(--h) * 0.09);
    filter: drop-shadow(0.12em 0.16em 0 rgb(20 36 28 / 0.07));
  }

  .lcd__digit,
  .lcd__colon,
  .lcd__degree {
    display: block;
    block-size: var(--h);
    inline-size: auto;
    transform: skewX(-6deg);
  }

  .lcd__digit {
    aspect-ratio: 60 / 104;
  }

  .lcd__colon {
    aspect-ratio: 14 / 104;
  }

  .lcd__degree {
    align-self: flex-start;
    aspect-ratio: 24 / 104;
  }

  .seg {
    fill: var(--ghost);
  }

  .lcd__colon rect {
    fill: var(--lit);
  }

  .lcd__degree rect {
    fill: none;
    stroke: var(--lit);
  }

  [data-d="0"] :is(.seg--a, .seg--b, .seg--c, .seg--d, .seg--e, .seg--f),
  [data-d="1"] :is(.seg--b, .seg--c),
  [data-d="2"] :is(.seg--a, .seg--b, .seg--d, .seg--e, .seg--g),
  [data-d="3"] :is(.seg--a, .seg--b, .seg--c, .seg--d, .seg--g),
  [data-d="4"] :is(.seg--b, .seg--c, .seg--f, .seg--g),
  [data-d="5"] :is(.seg--a, .seg--c, .seg--d, .seg--f, .seg--g),
  [data-d="6"] :is(.seg--a, .seg--c, .seg--d, .seg--e, .seg--f, .seg--g),
  [data-d="7"] :is(.seg--a, .seg--b, .seg--c),
  [data-d="8"] .seg,
  [data-d="9"] :is(.seg--a, .seg--b, .seg--c, .seg--d, .seg--f, .seg--g) {
    fill: var(--lit);
  }

  /* ---------- Buttons ---------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: 3rem;
    padding-inline: 1.375rem;
    border: 1.5px solid var(--lit);
    border-radius: 0.875rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease);
  }

  .btn--ink {
    background: var(--lit);
    color: var(--glass);
  }

  .btn--ink:hover {
    background: var(--ink);
  }

  .btn--line {
    background: transparent;
    color: var(--lit);
  }

  .btn--line:hover {
    background: var(--tint);
  }

  .btn--big {
    min-block-size: 3.5rem;
    padding-inline: 1.75rem;
    font-size: 1.0625rem;
  }

  /* ---------- Header ---------- */

  .top {
    border-block-end: 1px solid var(--line);
  }

  .top__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    min-block-size: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
  }

  /* A tiny unlit screen with one lit bar, the store's mark. */
  .brand__mark {
    inline-size: 1.75rem;
    block-size: 1.25rem;
    border: 1.5px solid var(--ink);
    border-radius: 0.375rem;
    background:
      linear-gradient(var(--lit), var(--lit)) center / 55% 3px no-repeat,
      var(--tint);
  }

  .top__nav {
    display: flex;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }

  .top__link {
    display: none;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .top__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .top__chat {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 1rem;
    border: 1.5px solid var(--lit);
    border-radius: 999px;
    color: var(--lit);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .top__chat:hover {
    background: var(--tint);
  }

  @media (min-width: 44rem) {
    .top__link {
      display: inline;
    }
  }

  /* ---------- Hero ---------- */

  .hero {
    display: grid;
    padding-inline: max(1rem, (100% - 74rem) / 2);
  }

  .hero__intro {
    padding-block: 1.5rem 0.75rem;
  }

  .hero__copy {
    display: grid;
    gap: 1rem;
    max-inline-size: 34rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
  }

  .hero__title-line {
    display: block;
  }

  .hero__lead {
    color: var(--muted);
    font-size: var(--step-0);
    max-inline-size: 32rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .hero__facts li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .hero__facts li::before {
    inline-size: 0.875rem;
    block-size: 0.3125rem;
    border-radius: 1px;
    background: var(--lit);
    content: "";
    transform: skewX(-20deg);
  }

  /* Painted, so the photo's white studio backdrop can multiply into it. */
  .hero__stage {
    position: relative;
    display: grid;
    align-content: start;
    padding-block: 0.75rem 2rem;
    background: var(--glass);
  }

  /* The bezel: matte plastic around the LCD, mode words printed on it. */
  .screen {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.875rem;
    border-radius: var(--radius-screen);
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.7), transparent 40%),
      var(--bezel);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      inset 0 -2px 0 var(--bezel-deep),
      0 1px 0 var(--bezel-deep),
      0 24px 48px -28px rgb(20 36 28 / 0.35);
  }

  .screen__modes {
    display: none;
  }

  .screen__hint {
    display: none;
  }

  .screen__glass {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    grid-column: 1 / -1;
    gap: 1px;
    overflow: hidden;
    border-radius: var(--radius-glass);
    background: var(--line);
    box-shadow:
      inset 0 0 0 1px rgb(20 36 28 / 0.16),
      inset 0 6px 14px -6px rgb(20 36 28 / 0.2);
    container-type: inline-size;
  }

  /* Static reflection on the glass, plus a band that sweeps with scroll. */
  .screen__glass::before,
  .screen__glass::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
  }

  .screen__glass::before {
    background: linear-gradient(
      200deg,
      rgb(255 255 255 / 0.55),
      rgb(255 255 255 / 0) 38%
    );
  }

  .screen__glass::after {
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgb(255 255 255 / 0.5) 42%,
      rgb(255 255 255 / 0.15) 48%,
      transparent 56%
    );
    opacity: 0;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-inline-size: 0;
    padding: clamp(1rem, 4cqi, 2rem);
    background: var(--tint);
    container-type: inline-size;
  }

  .panel__mode {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .panel__mode::before {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    background: var(--lit);
    content: "";
  }

  .panel__readout {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.5rem;
    margin-block: auto;
    padding-block: 0.5rem;
  }

  .panel__readout--date {
    align-items: center;
    gap: 1rem;
  }

  .panel__caption {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .lcd--xl {
    --h: min(27cqi, 10.5rem);
  }

  .lcd--lg {
    --h: min(20cqi, 6.5rem);
  }

  .lcd--sm {
    --h: min(10cqi, 3.75rem);
  }

  .panel__period {
    align-self: flex-start;
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 5cqi, 1.5rem);
    font-weight: 700;
    line-height: 1;
  }

  .prayers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 3.4cqi, 0.9375rem);
  }

  .prayers__item {
    padding: 0.125rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    color: var(--muted);
  }

  .prayers__item.is-next {
    border-color: var(--lit);
    background: rgb(27 61 48 / 0.07);
    color: var(--ink);
    font-weight: 700;
  }

  .bell {
    align-self: center;
    inline-size: clamp(1.75rem, 9cqi, 3rem);
    block-size: auto;
    color: var(--amber);
  }

  .hijri {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-display);
    line-height: 1.25;
  }

  .hijri__month {
    font-size: clamp(1.375rem, 8cqi, 2.5rem);
    font-weight: 700;
  }

  .hijri__year {
    color: var(--muted);
    font-size: clamp(1rem, 4.5cqi, 1.375rem);
  }

  .compass {
    inline-size: min(36cqi, 10rem);
    block-size: auto;
    overflow: visible;
  }

  .compass__tick {
    fill: var(--ghost);
  }

  .compass__tick.is-cardinal,
  .compass__tick.is-qibla {
    fill: var(--lit);
  }

  .compass__north {
    fill: var(--ink);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }

  .compass__needle {
    rotate: var(--bearing);
    transform-box: view-box;
    transform-origin: 60px 60px;
  }

  .compass__pointer,
  .compass__hub {
    fill: var(--lit);
  }

  .compass__tail {
    fill: var(--ghost);
  }

  .hero__watch {
    display: grid;
    justify-items: end;
    gap: 0.25rem;
    justify-self: end;
    inline-size: min(11rem, 44vw);
    margin-block-start: -2.5rem;
    margin-inline-end: 0.5rem;
  }

  .hero__photo {
    inline-size: 100%;
    mix-blend-mode: multiply;
  }

  .hero__watch-caption {
    display: grid;
    justify-items: end;
    font-size: var(--step--1);
    line-height: 1.5;
    text-align: end;
  }

  .hero__watch-caption a {
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  .hero__watch-caption span {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(20rem, 0.85fr) minmax(0, 1.6fr);
      gap: 3rem;
      align-items: start;
    }

    .hero__intro {
      display: grid;
      align-items: center;
      padding-block: 4rem;
    }

    .hero__copy {
      gap: 1.25rem;
    }

    .hero__lead {
      font-size: 1.125rem;
    }

    .hero__facts {
      display: grid;
      gap: 0.375rem;
    }

    .hero__stage {
      align-content: center;
      padding-block: 3rem;
      padding-inline-end: 10rem;
    }

    .hero__watch {
      position: absolute;
      inset-block-end: 14%;
      inset-inline-end: 0;
      inline-size: 16rem;
      margin: 0;
    }
  }

  /* ---------- Sections ---------- */

  .section {
    padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
  }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-block-end: 2rem;
  }

  .section__head--stack {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .section__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
  }

  .section__lead {
    max-inline-size: 36rem;
    margin-block-start: 0.5rem;
    color: var(--muted);
  }

  .lcd--counter {
    --h: clamp(3.5rem, 2rem + 4vw, 5.5rem);
  }

  /* ---------- Catalog ---------- */

  .catalog {
    display: grid;
    gap: 1rem;
  }

  .tile {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 0.75rem;
    border-radius: 1.25rem;
    background: var(--bezel);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 -1px 0 var(--bezel-deep);
  }

  .tile:has(.tile__link:focus-visible) {
    outline: 3px solid var(--lit);
    outline-offset: 3px;
  }

  .tile__bezel {
    overflow: hidden;
    border: 1px solid rgb(20 36 28 / 0.22);
    border-radius: 0.875rem;
    background: #fff;
  }

  .tile__photo {
    inline-size: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .tile__body {
    display: grid;
    gap: 0.375rem;
    align-content: start;
    min-block-size: 100%;
    padding-block: 0.25rem;
  }

  .tile__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .tile__model {
    font-family: var(--font-display);
    letter-spacing: 0.04em;
  }

  .tile__name {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .tile__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-block-start: 0.25rem;
  }

  .tile__amount {
    padding: 0.125rem 0.625rem;
    border-radius: 0.5rem;
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--lit);
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .tile__was {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .tile__link {
    justify-self: start;
    color: var(--lit);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.3em;
  }

  .tile__link::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: "";
  }

  .tile__link:focus-visible {
    outline: none;
  }

  .tile:hover {
    background: #dedbd2;
  }

  .tile:hover .tile__link {
    text-decoration-thickness: 3px;
  }

  .specs {
    display: grid;
    margin-block: 0.5rem;
    border-radius: 0.625rem;
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .specs__row {
    display: grid;
    grid-template-columns: 6.5rem auto minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.875rem;
    font-size: 0.9375rem;
  }

  .specs__row + .specs__row {
    border-block-start: 1px solid var(--line);
  }

  .specs dt {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.875rem;
  }

  /* The ◂ of a watch menu: points to the next thing in reading order. */
  .specs__row::after {
    grid-column: 2;
    grid-row: 1;
    inline-size: 0.4rem;
    block-size: 0.6rem;
    background: var(--lit);
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
    content: "";
  }

  .specs dd {
    grid-column: 3;
    grid-row: 1;
    font-weight: 600;
  }

  @media (min-width: 40rem) {
    .catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile {
      grid-template-columns: 1fr;
      align-content: start;
    }

    .tile--lead {
      grid-column: span 2;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-content: stretch;
      align-items: stretch;
    }

    .tile--lead .tile__bezel {
      display: grid;
      place-items: center;
    }

    .tile--lead .tile__body {
      align-content: center;
    }

    /* Two columns: an even count leaves the last tile alone on its row. */
    .tile:last-child:nth-child(even) {
      grid-column: span 2;
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .catalog {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .tile:last-child:nth-child(even) {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .tile--lead .tile__name {
      font-family: var(--font-display);
      font-size: 1.5rem;
      line-height: 1.4;
    }
  }

  /* ---------- Features as a watch menu ---------- */

  .split {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .split {
      grid-template-columns: minmax(16rem, 0.7fr) minmax(0, 1.3fr);
      gap: 4rem;
    }
  }

  .menu {
    padding: 0.625rem;
    border-radius: var(--radius-screen);
    background: var(--bezel);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 -2px 0 var(--bezel-deep);
  }

  .menu__row {
    display: grid;
    grid-template-columns: 4.5rem auto minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: baseline;
    padding: 1.125rem 1.25rem;
    background: var(--tint);
  }

  .menu__row:first-child {
    border-start-start-radius: var(--radius-glass);
    border-start-end-radius: var(--radius-glass);
  }

  .menu__row:last-child {
    border-end-start-radius: var(--radius-glass);
    border-end-end-radius: var(--radius-glass);
  }

  .menu__row + .menu__row {
    margin-block-start: 1px;
  }

  .menu__mode {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--lit);
  }

  .menu__caret {
    inline-size: 0.5rem;
    block-size: 0.75rem;
    background: var(--lit);
    clip-path: polygon(100% 0, 0 50%, 100% 100%);
  }

  .menu__title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .menu__text {
    margin-block-start: 0.125rem;
    color: var(--muted);
    font-size: 0.9875rem;
  }

  @media (max-width: 30rem) {
    .menu__row {
      grid-template-columns: auto minmax(0, 1fr);
      padding-inline: 1rem;
    }

    .menu__caret {
      display: none;
    }

    .menu__mode {
      min-inline-size: 3.5rem;
    }
  }

  /* ---------- Order steps + delivery ---------- */

  .order {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .order {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }

  .steps {
    display: grid;
    gap: 0.25rem;
  }

  .step {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    padding-block: 1.25rem;
  }

  .step + .step {
    border-block-start: 1px solid var(--line);
  }

  .lcd--step {
    --h: 4rem;
    justify-content: center;
  }

  .step__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.4;
  }

  .step__text {
    margin-block-start: 0.25rem;
    color: var(--muted);
  }

  .delivery {
    padding: 0.75rem;
    border-radius: var(--radius-screen);
    background: var(--bezel);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 -2px 0 var(--bezel-deep);
  }

  .delivery__title {
    padding: 0.5rem 0.75rem 0.75rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .delivery__list {
    overflow: hidden;
    border-radius: var(--radius-glass);
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .delivery__row {
    display: grid;
    grid-template-columns: auto minmax(1rem, 1fr) auto;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    padding: 1rem 1.25rem;
  }

  .delivery__row + .delivery__row {
    border-block-start: 1px dashed rgb(20 36 28 / 0.2);
  }

  .delivery__zone {
    font-weight: 600;
  }

  .delivery__leader {
    border-block-end: 2px dotted var(--ghost);
    translate: 0 -0.3em;
  }

  .delivery__fee {
    color: var(--lit);
    font-size: 1.375rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .delivery__time {
    grid-column: 1 / -1;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .delivery__cash {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-glass);
    background: var(--tint);
    box-shadow: inset 0 0 0 1px var(--line);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .delivery__led {
    inline-size: 0.75rem;
    block-size: 0.75rem;
