---
// Style exploration 5, «النجمة والقبلة»: one eight-fold khatam rosette is the
// hero and doubles as a Qibla dial. Scrolling inks the rosette, lays it flat
// like a compass and swings a needle to the bearing from Amman to Makkah.
import "@fontsource-variable/noto-kufi-arabic";
import "@fontsource-variable/readex-pro";
import { Picture } from "astro:assets";

import { deliveryTime } from "../lib/delivery";
import { getHomeData } from "../lib/home-data";
import { formatPrice } from "../lib/money";

const {
  store,
  products,
  categoryName,
  zones,
  chatUrl,
  digits,
  features,
  steps,
} = await getHomeData();

const [firstProduct] = products;

const featured =
  products.find((product) => product.data.featured) ?? firstProduct;

if (!featured) {
  throw new Error("The home page needs at least one product.");
}

const [featuredCover] = featured.data.images;

if (!featuredCover) {
  throw new Error(`${featured.id} has no photo.`);
}

// ---- Rosette geometry, in a 1000 × 1000 box centred on (500, 500). ----
// Angles are compass bearings: 0° is north (up), clockwise positive.
const CENTER = 500;
const FOLD = 8;
const STEP = 360 / FOLD;
const HALF_STEP = STEP / 2;
const DEGREES_PER_RADIAN = 180 / Math.PI;
const PRECISION = 100;

const round = (value: number): number =>
  Math.round(value * PRECISION) / PRECISION;

const toRadians = (degrees: number): number => degrees / DEGREES_PER_RADIAN;

const point = (radius: number, bearing: number): [number, number] => [
  round(CENTER + radius * Math.sin(toRadians(bearing))),
  round(CENTER - radius * Math.cos(toRadians(bearing))),
];

const xy = (radius: number, bearing: number): string =>
  point(radius, bearing).join(" ");

const indices = (count: number): number[] =>
  Array.from({ length: count }, (_, index) => index);

const closed = (points: string[]): string => `M${points.join("L")}Z`;

// Khatam: two overlapping squares. Tips on the 8 compass points, the concave
// corners between them where the square edges cross.
const STAR_RADIUS = 250;

const STAR_INNER =
  (STAR_RADIUS * Math.cos(toRadians(STEP))) / Math.cos(toRadians(HALF_STEP));

const khatam = closed(
  indices(FOLD * 2).map((index) =>
    xy(index % 2 === 0 ? STAR_RADIUS : STAR_INNER, index * HALF_STEP)
  )
);

// White octagon mat behind the photo window, flat edge to the north.
const MAT_APOTHEM = 176;
const WINDOW_APOTHEM = 164;

const octagon = (apothem: number): string =>
  closed(
    indices(FOLD).map((index) =>
      xy(apothem / Math.cos(toRadians(HALF_STEP)), HALF_STEP + index * STEP)
    )
  );

const mat = octagon(MAT_APOTHEM);
const windowEdge = octagon(WINDOW_APOTHEM);
const WINDOW_SIZE = `${(WINDOW_APOTHEM * 2) / 10}%`;

// Outer vertices of the rosette, where the feature labels sit.
const OUTER_RADIUS = 410;

// Petals wrap each notch of the star and end on a 16-point zigzag.
const PETAL_SHOULDER = 318;
const PETAL_SPREAD = 11;
const PETAL_APEX = 360;

// {8/3} star polygon on the outer vertices: the long interlace lines.
const interlace = closed(
  indices(FOLD).map((index) => xy(OUTER_RADIUS, ((index * 3) % FOLD) * STEP))
);

const petals = indices(FOLD)
  .map((index) => {
    const axis = HALF_STEP + index * STEP;

    return `M${[
      xy(STAR_RADIUS, axis - HALF_STEP),
      xy(PETAL_SHOULDER, axis - PETAL_SPREAD),
      xy(PETAL_APEX, axis),
      xy(PETAL_SHOULDER, axis + PETAL_SPREAD),
      xy(STAR_RADIUS, axis + HALF_STEP),
    ].join("L")}`;
  })
  .join("");

const rays = indices(FOLD)
  .map(
    (index) =>
      `M${xy(STAR_RADIUS, index * STEP)}L${xy(OUTER_RADIUS, index * STEP)}`
  )
  .join("");

const zigzag = closed(
  indices(FOLD * 2).map((index) =>
    xy(index % 2 === 0 ? OUTER_RADIUS : PETAL_APEX, index * HALF_STEP)
  )
);

// Compass ring: ticks every 5°, longer every 15° and 45°, numerals every 45°.
const RING_RADIUS = 428;
const TICK_START = 436;
const TICK_MINOR = 450;
const TICK_MEDIUM = 458;
const TICK_MAJOR = 468;
const NUMERAL_RADIUS = 484;
const TICK_EVERY = 5;
const MEDIUM_EVERY = 15;
const FULL_TURN = 360;

const tickPath = (filter: (bearing: number) => boolean, end: number): string =>
  indices(FULL_TURN / TICK_EVERY)
    .map((index) => index * TICK_EVERY)
    .filter(filter)
    .map((bearing) => `M${xy(TICK_START, bearing)}L${xy(end, bearing)}`)
    .join("");

const minorTicks = tickPath(
  (bearing) => bearing % MEDIUM_EVERY !== 0,
  TICK_MINOR
);

const mediumTicks = tickPath(
  (bearing) => bearing % MEDIUM_EVERY === 0 && bearing % STEP !== 0,
  TICK_MEDIUM
);

const majorTicks = tickPath((bearing) => bearing % STEP === 0, TICK_MAJOR);

const numerals = indices(FOLD).map((index) => {
  const bearing = index * STEP;
  const [x, y] = point(NUMERAL_RADIUS, bearing);

  return { label: index === 0 ? "ش" : digits.format(bearing), x, y };
});

// Faint compass-and-straightedge construction left visible under the ink.
const CONSTRUCTION_RADII = [STAR_INNER, STAR_RADIUS, PETAL_APEX, OUTER_RADIUS];

const construction = indices(FOLD * 2)
  .map(
    (index) =>
      `M${xy(STAR_INNER, index * HALF_STEP)}L${xy(RING_RADIUS, index * HALF_STEP)}`
  )
  .join("");

const VERTEX_CIRCLE = 62;

const vertexCircles = indices(FOLD).map((index) =>
  point(OUTER_RADIUS, index * STEP)
);

// Qibla from Amman, true north. An example for the copy, not a calculation.
const QIBLA_BEARING = 157;
const qiblaLabel = `${digits.format(QIBLA_BEARING)}°`;
const QIBLA_TICK_FROM = 372;
const QIBLA_TICK_TO = 476;
const KAABA_RADIUS = 444;
const [kaabaX, kaabaY] = point(KAABA_RADIUS, QIBLA_BEARING);

// Needle drawn pointing north; CSS turns it to the bearing.
const NEEDLE_TIP = 420;
const NEEDLE_WAIST = 300;
const NEEDLE_WIDTH = 13;
const NEEDLE_BASE = 196;
const needle = `M${CENTER} ${CENTER - NEEDLE_TIP}L${CENTER + NEEDLE_WIDTH} ${CENTER - NEEDLE_WAIST}L${CENTER} ${CENTER - NEEDLE_BASE}L${CENTER - NEEDLE_WIDTH} ${CENTER - NEEDLE_WAIST}Z`;
const needleSpine = `M${CENTER} ${CENTER - NEEDLE_TIP}V${CENTER - NEEDLE_BASE}`;

// Feature keywords on the five outer vertices of the half facing the copy;
// the other half runs off the page.
const LABEL_BEARINGS = [0, 45, 90, 135, 180] as const;

// Just inside the outer vertices, clear of the degree numerals.
const LABEL_RADIUS = 380;
const PERCENT = 100;

const labels = features.map((feature, index) => {
  const bearing = LABEL_BEARINGS[index] ?? 0;
  const [x, y] = point(LABEL_RADIUS, bearing);

  return {
    // Logical offsets: inline-start is the right edge in RTL.
    start: `${round(PERCENT - x / 10)}%`,
    text: feature.title,
    top: `${round(y / 10)}%`,
  };
});

// Small eight-point star used as a glyph, in a 24 × 24 box.
const GLYPH_CENTER = 12;
const GLYPH_OUTER = 11;

const GLYPH_INNER =
  (GLYPH_OUTER * Math.cos(toRadians(STEP))) / Math.cos(toRadians(HALF_STEP));

const glyph = closed(
  indices(FOLD * 2).map((index) => {
    const radius = index % 2 === 0 ? GLYPH_OUTER : GLYPH_INNER;
    const angle = toRadians(index * HALF_STEP);

    return `${round(GLYPH_CENTER + radius * Math.sin(angle))} ${round(GLYPH_CENTER - radius * Math.cos(angle))}`;
  })
);

// Regular octagon inscribed in a 100 × 100 square, for the product windows.
const CUT = round(PERCENT / (2 + Math.SQRT2));
const FAR = round(PERCENT - CUT);
const cardOctagon = `${CUT},0 ${FAR},0 100,${CUT} 100,${FAR} ${FAR},100 ${CUT},100 0,${FAR} 0,${CUT}`;

const PHONE_GROUPS =
  /^\+(?<country>\d{3})(?<operator>\d{2})(?<first>\d{3})(?<last>\d{4})$/u;

const { contact } = store;

const phoneDisplay = contact.phone.replace(
  PHONE_GROUPS,
  "+$<country> $<operator> $<first> $<last>"
);

const year = new Date().getFullYear();
const NEW_WINDOW = "(يفتح في نافذة جديدة)";
const CARD_COLUMNS = 4;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{store.name}: النجمة والقبلة</title>
    <meta content={store.tagline} name="description" />
    <meta content="noindex" name="robots" />
    <meta content="light" name="color-scheme" />
    <meta content="#ffffff" name="theme-color" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">
      انتقل إلى المحتوى
    </a>

    <header class="masthead">
      <a class="brand" href="/5">
        <svg aria-hidden="true" class="brand__mark" viewBox="0 0 24 24">
          <path d={glyph}></path>
        </svg>
        {store.name}
      </a>
      <nav aria-label="أقسام الصفحة" class="masthead__nav">
        <a href="#watches">الساعات</a>
        <a href="#features">المزايا</a>
        <a href="#order">الطلب والتوصيل</a>
      </nav>
      <a
        class="masthead__chat"
        href={chatUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        واتساب
        <span class="visually-hidden">{NEW_WINDOW}</span>
      </a>
    </header>

    <main id="main">
      <section aria-labelledby="hero-title" class="stage">
        <div class="stage__copy">
          <p class="stage__brand">ساعات الحرمين الأصلية في الأردن</p>
          <h1 class="stage__title" id="hero-title">
            مواقيت الأذان واتجاه القبلة في ساعة واحدة
          </h1>
          <p class="stage__lead">
            ساعات أذان أصلية من الحرمين تنبّهك لكل صلاة وتدلّك على القبلة، تطلبها
            عبر واتساب وتدفع عند الاستلام.
          </p>
          <div class="stage__price">
            <a class="stage__price-name" href={`/watches/${featured.id}/`}>
              {featured.data.name}
            </a>
            <p class="stage__price-value">
              {formatPrice(featured.data.price, featured.data.currency)}
              {featured.data.compareAtPrice !== undefined && (
                <s>
                  <span class="visually-hidden">بدلًا من</span>
                  {formatPrice(
                    featured.data.compareAtPrice,
                    featured.data.currency
                  )}
                </s>
              )}
            </p>
          </div>
          <div class="stage__actions">
            <a class="button button--solid" href="#watches">
              تصفّح الساعات
            </a>
            <a
              class="button button--line"
              href={chatUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              اطلب عبر واتساب
              <span class="visually-hidden">{NEW_WINDOW}</span>
            </a>
          </div>
        </div>

        <div class="stage__track">
          <div class="stage__frame">
            <div class="dial-wrap">
              <div class="dial-tilt" data-dial-tilt>
                <div class="dial" style={`--bearing: ${QIBLA_BEARING}deg`}>
                  <svg
                    aria-hidden="true"
                    class="layer layer--base"
                    style="--z: 0"
                    viewBox="0 0 1000 1000"
                  >
                    <g class="construction">
                      {CONSTRUCTION_RADII.map((radius) => (
                        <circle cx={CENTER} cy={CENTER} r={round(radius)} />
                      ))}
                      {vertexCircles.map(([cx, cy]) => (
                        <circle cx={cx} cy={cy} r={VERTEX_CIRCLE} />
                      ))}
                      <path d={construction}></path>
                    </g>
                    <g class="ghost">
                      <circle cx={CENTER} cy={CENTER} r={OUTER_RADIUS} />
                      <path d={interlace}></path>
                      <path d={rays}></path>
                      <path d={petals}></path>
                      <path d={zigzag}></path>
                    </g>
                    <circle
                      class="ring"
                      cx={CENTER}
                      cy={CENTER}
                      r={RING_RADIUS}
                    />
                    <path class="tick tick--minor" d={minorTicks}></path>
                    <path class="tick tick--medium" d={mediumTicks}></path>
                    <path class="tick tick--major" d={majorTicks}></path>
                    {numerals.map(({ label, x, y }, index) => (
                      <text
                        class:list={[
                          "numeral",
                          { "numeral--north": index === 0 },
                        ]}
                        x={x}
                        y={y}
                      >
                        {label}
                      </text>
                    ))}
                    <g class="qibla-mark">
                      <path
                        d={`M${xy(QIBLA_TICK_FROM, QIBLA_BEARING)}L${xy(QIBLA_TICK_TO, QIBLA_BEARING)}`}
                      ></path>
                      <rect
                        height="18"
                        transform={`translate(${kaabaX} ${kaabaY}) rotate(${QIBLA_BEARING})`}
                        width="18"
                        x="-9"
                        y="-9"
                      ></rect>
                    </g>
                  </svg>

                  <svg
                    aria-hidden="true"
                    class="layer layer--ink"
                    style="--z: 40"
                    viewBox="0 0 1000 1000"
                  >
                    <circle
                      class="ink ink--ring"
                      cx={CENTER}
                      cy={CENTER}
                      pathLength="1"
                      r={OUTER_RADIUS}
                    />
                    <path
                      class="ink ink--interlace"
                      d={interlace}
                      pathLength="1"
                    ></path>
                    <path class="ink ink--rays" d={rays} pathLength="1"></path>
                    <path
                      class="ink ink--petals"
                      d={petals}
                      pathLength="1"
                    ></path>
                    <path
                      class="ink ink--zigzag"
                      d={zigzag}
                      pathLength="1"
                    ></path>
                  </svg>

                  <svg
                    aria-hidden="true"
                    class="layer layer--star"
                    style="--z: 80"
                    viewBox="0 0 1000 1000"
                  >
                    <path class="star" d={khatam}></path>
                    <path class="mat" d={mat}></path>
                    <path class="mat-edge" d={windowEdge}></path>
                  </svg>

                  <div class="layer layer--window" style="--z: 80">
                    <div class="window" style={`--size: ${WINDOW_SIZE}`}>
                      <Picture
                        alt={featuredCover.alt}
                        class="window__image"
                        fetchpriority="high"
                        formats={["avif", "webp"]}
                        height={640}
                        loading="eager"
                        sizes="(min-width: 60rem) 17rem, 36vw"
                        src={featuredCover.src}
                        width={640}
                        widths={[320, 480, 640]}
                      />
                    </div>
                  </div>

                  <div
                    aria-hidden="true"
                    class="layer layer--labels"
                    style="--z: 100"
                  >
                    {labels.map((label) => (
                      <span
                        class="vertex-label"
                        style={`inset-block-start: ${label.top}; inset-inline-start: ${label.start}`}
                      >
                        {label.text}
                      </span>
                    ))}
                  </div>

                  <svg
                    aria-hidden="true"
                    class="layer layer--needle"
                    style="--z: 86"
                    viewBox="0 0 1000 1000"
                  >
                    <path class="needle" d={needle}></path>
                    <path class="needle-spine" d={needleSpine}></path>
                  </svg>
                </div>
              </div>
            </div>

            <div class="qibla-note">
              <p class="qibla-note__title">اتجاه القبلة</p>
              <p class="qibla-note__bearing">
                مثال من عمّان:{" "}
                <span class="qibla-note__degrees">{qiblaLabel}</span>
              </p>
              <p class="qibla-note__text">
                تحدد الساعة اتجاه القبلة من موقعك بضغطة زر، في عمّان أو في أي
                مدينة تسافر إليها.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section aria-labelledby="watches-title" class="section" id="watches">
        <div class="section__head">
          <h2 id="watches-title">الساعات</h2>
          <p>
            كل القطع أصلية من الحرمين. افتح أي ساعة لترى مواصفاتها وطريقة
            استخدامها.
          </p>
        </div>
        <ul class="catalog" role="list">
          {products.map((product, index) => {
            const [cover] = product.data.images;
            return (
              <li class="card" style={`--i: ${index % CARD_COLUMNS}`}>
                <div class="card__window">
                  <div class="card__clip">
                    <Picture
                      alt={cover?.alt ?? product.data.name}
                      class="card__image"
                      formats={["avif", "webp"]}
                      height={480}
                      loading="lazy"
                      sizes="(min-width: 60rem) 16rem, (min-width: 40rem) 30vw, 7.5rem"
                      src={cover?.src ?? featuredCover.src}
                      width={480}
                      widths={[240, 360, 480]}
                    />
                  </div>
                  <svg
                    aria-hidden="true"
                    class="card__outline"
                    preserveAspectRatio="none"
                    viewBox="0 0 100 100"
                  >
                    <polygon pathLength="1" points={cardOctagon}></polygon>
                  </svg>
                </div>
                <div class="card__body">
                  <p class="card__category">{categoryName(product)}</p>
                  <h3 class="card__name">
                    <a href={`/watches/${product.id}/`}>{product.data.name}</a>
                  </h3>
                  <p class="card__price">
                    {formatPrice(product.data.price, product.data.currency)}
                    {product.data.compareAtPrice !== undefined && (
                      <s>
                        <span class="visually-hidden">بدلًا من</span>
                        {formatPrice(
                          product.data.compareAtPrice,
                          product.data.currency
                        )}
                      </s>
                    )}
                  </p>
                  <span aria-hidden="true" class="card__more">
                    التفاصيل
                  </span>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <section
        aria-labelledby="features-title"
        class="section features"
        id="features"
      >
        <div class="section__head features__head">
          <h2 id="features-title">ما تفعله الساعة</h2>
          <p>خمس مزايا في كل ساعة من الحرمين، من الأذان إلى التوصيل.</p>
        </div>
        <ul class="features__list" role="list">
          {features.map((feature) => (
            <li class="feature">
              <svg
                aria-hidden="true"
                class="feature__glyph"
                viewBox="0 0 24 24"
              >
                <path d={glyph}></path>
              </svg>
              <h3 class="feature__title">{feature.title}</h3>
              <p class="feature__text">{feature.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="order-title" class="order" id="order">
        <div class="section">
          <div class="section__head">
            <h2 id="order-title">اطلب في ثلاث خطوات</h2>
          </div>
          <div class="steps">
            <svg
              aria-hidden="true"
              class="steps__line"
              preserveAspectRatio="none"
              viewBox="0 0 1000 10"
            >
              <path d="M1000 5H0" pathLength="1"></path>
            </svg>
            <ol class="steps__list">
              {steps.map((step, index) => (
                <li class="step">
                  <span aria-hidden="true" class="step__node">
                    {digits.format(index + 1)}
                  </span>
                  <h3 class="step__title">{step.title}</h3>
                  <p class="step__text">{step.text}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="strip">
          <div class="strip__inner">
            <div class="strip__cash">
              <p class="strip__cash-title">الدفع نقدًا عند الاستلام</p>
              <p>لا تحويل ولا بطاقة. تدفع للمندوب حين تصلك الساعة.</p>
            </div>
            <table class="zones">
              <caption>التوصيل داخل الأردن</caption>
              <thead>
                <tr>
                  <th scope="col">المنطقة</th>
                  <th scope="col">الرسوم</th>
                  <th scope="col">المدة</th>
                </tr>
              </thead>
              <tbody>
                {zones.map((zone) => (
                  <tr>
                    <th scope="row">{zone.data.name}</th>
                    <td>{formatPrice(zone.data.fee, zone.data.currency)}</td>
                    <td>
                      {deliveryTime(zone.data.minDays, zone.data.maxDays)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section aria-labelledby="contact-title" class="section contact">
        <h2 id="contact-title">اسألنا قبل أن تطلب</h2>
        <p class="contact__text">
          راسلنا على واتساب لتسأل عن أي ساعة أو لترسل طلبك مباشرة، أو اتصل بنا.
        </p>
        <div class="contact__actions">
          <a
            class="button button--solid"
            href={chatUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            راسلنا على واتساب
            <span class="visually-hidden">{NEW_WINDOW}</span>
          </a>
          <p class="contact__phone">
            أو اتصل على
            <a dir="ltr" href={`tel:${contact.phone}`}>
              {phoneDisplay}
            </a>
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>
        {store.name}، {contact.address}
      </p>
      <p>© {digits.format(year).replace("٬", "")}</p>
    </footer>

    <script>
      // Gentle pointer tilt of the dial on desktop. The scroll animation owns
      // the dial itself; this only nudges its parent a few degrees.
      const MAX_TILT_DEG = 5;
      const HALF = 0.5;
      const target = document.querySelector<HTMLElement>("[data-dial-tilt]");

      const finePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)"
      );

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      let pending = 0;

      const reset = (): void => {
        target?.style.removeProperty("--tilt-x");
        target?.style.removeProperty("--tilt-y");
      };

      const onMove = (event: PointerEvent): void => {
        if (!target || !finePointer.matches || reducedMotion.matches) {
          return;
        }

        cancelAnimationFrame(pending);
        pending = requestAnimationFrame(() => {
          const x = event.clientX / window.innerWidth - HALF;
          const y = event.clientY / window.innerHeight - HALF;
          target.style.setProperty(
            "--tilt-x",
            `${(-y * MAX_TILT_DEG).toFixed(2)}deg`
          );
          target.style.setProperty(
            "--tilt-y",
            `${(x * MAX_TILT_DEG).toFixed(2)}deg`
          );
        });
      };

      window.addEventListener("pointermove", onMove, { passive: true });

