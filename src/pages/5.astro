          inset-block: 3.5rem 0;
          inset-inline-start: 1.75rem;
          border-inline-start: 1px dashed var(--ink);
          content: "";
        }

        .step__title {
          padding-block-start: 0.5rem;
        }
      }

      /* ---- Scroll-driven motion (only when wanted and supported) ---- */
      @keyframes s5-draw {
        from {
          stroke-dashoffset: 1;
        }

        to {
          stroke-dashoffset: 0;
        }
      }

      @keyframes s5-lay-flat {
        from {
          transform: none;
        }

        to {
          transform: rotateX(var(--lay-angle)) scale(var(--lay-scale));
        }
      }

      @keyframes s5-shift {
        to {
          translate: var(--shift-x) var(--shift-y);
        }
      }

      @keyframes s5-fade-out {
        to {
          opacity: 0;
        }
      }

      @keyframes s5-fade-in {
        from {
          opacity: 0;
        }

        to {
          opacity: 1;
        }
      }

      @keyframes s5-swing {
        from {
          opacity: 0;
          rotate: 0deg;
        }

        20% {
          opacity: 1;
          rotate: 0deg;
        }

        to {
          opacity: 1;
          rotate: var(--bearing);
        }
      }

      @keyframes s5-note {
        from {
          opacity: 0;
          translate: 0 2rem;
        }

        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      @keyframes s5-grow-y {
        from {
          scale: 1 0;
        }

        to {
          scale: 1 1;
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
          .stage {
            --lay-angle: 56deg;
            --lay-scale: 1.04;
            display: block;
            min-block-size: 0;
          }

          .stage__copy {
            position: absolute;
            inset-block-start: 0;
            inset-inline-start: 0;
            justify-content: center;
            inline-size: 46%;
            block-size: calc(100svh - var(--header));
            padding-block: 0;
          }

          .stage__track {
            block-size: 270svh;
            view-timeline: --dial block;
          }

          .stage__frame {
            position: sticky;
            inset-block-start: 0;
            display: block;
            block-size: 100svh;
            padding: 0;
          }

          .dial-wrap {
            --shift-x: calc(var(--dial) * var(--crop) + 6vw);
            --shift-y: 0px;
            position: absolute;
            inset-block-start: calc(50% - var(--header) / 2 - var(--dial) / 2);
            inset-inline-end: 0;
            animation-name: s5-shift;
            animation-fill-mode: both;
            animation-timing-function: var(--ease);
            animation-timeline: --dial;
            animation-range: contain 36% contain 64%;
          }

          .dial {
            animation-name: s5-lay-flat;
            animation-fill-mode: both;
            animation-timing-function: var(--ease);
            animation-timeline: --dial;
            animation-range: contain 36% contain 64%;
          }

          .ink {
            stroke-dasharray: 1;
            animation-name: s5-draw;
            animation-fill-mode: both;
            animation-timing-function: linear;
            animation-timeline: --dial;
          }

          .ink--ring {
            animation-range: contain 0% contain 12%;
          }

          .ink--interlace {
            animation-range: contain 4% contain 20%;
          }

          .ink--rays {
            animation-range: contain 10% contain 22%;
          }

          .ink--petals {
            animation-range: contain 14% contain 28%;
          }

          .ink--zigzag {
            animation-range: contain 20% contain 33%;
          }

          .layer--labels {
            animation-name: s5-fade-out;
            animation-fill-mode: both;
            animation-timeline: --dial;
            animation-range: contain 34% contain 46%;
          }

          .layer--needle {
            animation-name: s5-swing;
            animation-fill-mode: both;
            animation-timing-function: var(--ease);
            animation-timeline: --dial;
            animation-range: contain 56% contain 88%;
          }

          .qibla-mark {
            animation-name: s5-fade-in;
            animation-fill-mode: both;
            animation-timeline: --dial;
            animation-range: contain 78% contain 88%;
          }

          .qibla-note {
            position: absolute;
            inset-block-start: calc(50% - 6rem);
            inset-inline-start: var(--gutter);
            inline-size: min(24rem, 32%);
            margin: 0;
            text-align: start;
            animation-name: s5-note;
            animation-fill-mode: both;
            animation-timing-function: var(--ease);
            animation-timeline: --dial;
            animation-range: contain 74% contain 90%;
          }

          .card__outline polygon {
            stroke-dasharray: 1;
            animation-name: s5-draw;
            animation-fill-mode: both;
            animation-timing-function: var(--ease);
            animation-timeline: view();
            animation-range: entry calc(20% + var(--i) * 10%) cover
              calc(45% + var(--i) * 6%);
          }

          .steps__line path {
            stroke-dasharray: 1;
            stroke-width: 1.5;
            animation-name: s5-draw;
            animation-fill-mode: both;
            animation-timing-function: linear;
            animation-timeline: view();
            animation-range: entry 60% cover 50%;
          }

          .step:not(:last-child)::before {
            transform-origin: top;
            animation-name: s5-grow-y;
            animation-fill-mode: both;
            animation-timing-function: linear;
            animation-timeline: view();
            animation-range: entry 80% cover 55%;
          }

          @media (width < 60rem) {
            .stage__copy {
              position: relative;
              inline-size: auto;
              block-size: auto;
              padding-block: 2rem 1rem;
            }

            .stage__track {
              block-size: 240svh;
            }

            .dial-wrap {
              --shift-x: calc(
                var(--dial) * var(--crop) - (var(--dial) - 100vw) / 2
              );
              --shift-y: 16svh;
              inset-block-start: 0.5rem;
            }

            .qibla-note {
              inset-block: auto 2rem;
              inset-inline: var(--gutter);
              inline-size: auto;
              text-align: center;
            }
          }
        }
      }
    </style>
  </body>
</html>
