---
// /3 «البلّورة»: a gallery-white home where one sculptural 3D watch crystal
// turns as you read. The canvas is progressive: the page ships an SVG crystal
// and the real product photo, and three.js mounts later only where it can.
import "@fontsource-variable/el-messiri";
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/500.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import { Picture } from "astro:assets";

import { deliveryTime } from "../lib/delivery";
import { getHomeData } from "../lib/home-data";
import { formatPrice } from "../lib/money";

const {
  store,
  products,
  categoryName,
  zones,
  chatUrl,
  digits,
  features,
  steps,
} = await getHomeData();

const [firstProduct] = products;

const featured =
  products.find((product) => product.data.featured) ?? firstProduct;

const [featuredImage] = featured.data.images;

const phoneHref = `tel:${store.contact.phone}`;
const year = digits.format(new Date().getFullYear()).replaceAll("٬", "");

/** Great-circle bearing from Amman to the Kaaba; the SVG needle uses it too. */
const QIBLA_BEARING = 161;

const CARD_IMAGE = 640;
const FEATURED_IMAGE = 560;
const NEW_WINDOW = "(يفتح في نافذة جديدة)";

// Line icons for the five features, keyed by the icon name in home-data.
const ICONS = new Map<string, readonly string[]>([
  [
    "azan",
    ["M12 2.5v3", "M8.5 21V10a3.5 3.5 0 0 1 7 0v11", "M6 21h12", "M10.5 14h3"],
  ],
  [
    "qibla",
    [
      "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z",
      "m12 6.5 2.2 5.5-2.2 5.5-2.2-5.5Z",
    ],
  ],
  [
    "calendar",
    [
      "M4 6.5h16v13.5H4Z",
      "M4 10.5h16",
      "M8.5 4v4",
      "M15.5 4v4",
      "M13.5 13a2.6 2.6 0 1 0 1.8 4.4 2.2 2.2 0 0 1-1.8-4.4Z",
    ],
  ],
  [
    "shield",
    [
      "M12 3 19 6v5.5c0 4.6-3 7.7-7 9.5-4-1.8-7-4.9-7-9.5V6Z",
      "m9 12 2.2 2.2L15.5 10",
    ],
  ],
  [
    "truck",
    [
      "M3 6.5h11v10H3Z",
      "M14 10h3.8l3.2 3.2v3.3h-7",
      "M7.5 19.5a1.6 1.6 0 1 0 0-.01",
      "M17.5 19.5a1.6 1.6 0 1 0 0-.01",
    ],
  ],
]);

// Poses for the 3D crystal, in scroll order: the hero, then each feature.
const poseNames = ["hero", ...features.map((feature) => feature.icon)];

// Static SVG crystal: hour markers and the khatam.
const markers = Array.from({ length: 12 }, (_, hour) => hour * 30);
---

<!doctype html>
<html dir="rtl" lang="ar">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="noindex" name="robots" />
    <meta content="light" name="color-scheme" />
    <meta content={store.tagline} name="description" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <title>{`${store.name}: البلّورة`}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      تخطَّ إلى المحتوى
    </a>

    <header class="masthead">
      <a class="brand" href="/3">
        <svg aria-hidden="true" class="brand__mark" viewBox="0 0 32 32">
          <circle
            cx="16"
            cy="16"
            fill="none"
            r="13"
            stroke="currentColor"
            stroke-width="2.4"
          ></circle>
          <path d="M16 7.5 17.8 16 16 24.5 14.2 16Z" fill="#1f5c57"></path>
        </svg>
        {store.name}
      </a>
      <nav aria-label="أقسام الصفحة" class="masthead__nav">
        <a href="#collection">الساعات</a>
        <a href="#features">المزايا</a>
        <a href="#order">طريقة الطلب</a>
      </nav>
      <a
        class="masthead__chat"
        href={chatUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        واتساب
        <span class="visually-hidden">{NEW_WINDOW}</span>
      </a>
    </header>

    <main id="main">
      <div class="vitrine">
        <section aria-labelledby="hero-title" class="hero" data-pose="hero">
          <h1 class="hero__title" id="hero-title">
            ساعة تعرف موعد الأذان، وتشير إلى القبلة
          </h1>
          <p class="hero__lede">{store.tagline}.</p>
          <div class="hero__actions">
            <a
              class="button button--solid"
              href={chatUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              اطلب عبر واتساب
              <span class="visually-hidden">{NEW_WINDOW}</span>
            </a>
            <a class="button button--line" href="#collection">
              تصفّح الساعات
            </a>
          </div>

          <article class="specimen">
            <div class="specimen__plate">
              <Picture
                alt={featuredImage.alt}
                class="specimen__image"
                fetchpriority="high"
                formats={["avif", "webp"]}
                height={FEATURED_IMAGE}
                loading="eager"
                sizes="(min-width: 60rem) 13rem, 40vw"
                src={featuredImage.src}
                width={FEATURED_IMAGE}
                widths={[240, 400, FEATURED_IMAGE]}
              />
            </div>
            <div class="specimen__text">
              <p class="specimen__category">{categoryName(featured)}</p>
              <h2 class="specimen__name">
                <a href={`/watches/${featured.id}/`}>{featured.data.name}</a>
              </h2>
              <p class="specimen__price">
                <span class="visually-hidden">السعر:</span>
                {formatPrice(featured.data.price, featured.data.currency)}
                {featured.data.compareAtPrice !== undefined && (
                  <s>
                    <span class="visually-hidden">بدلًا من</span>
                    {formatPrice(
                      featured.data.compareAtPrice,
                      featured.data.currency
                    )}
                  </s>
                )}
              </p>
            </div>
          </article>
        </section>

        <div class="stage-column">
          <div class="stage" data-crystal data-poses={poseNames.join(" ")}>
            <svg
              aria-label="بلّورة ساعة من النحاس والزجاج، عليها خاتم ثماني وإبرة تشير إلى القبلة"
              class="stage__fallback"
              role="img"
              viewBox="0 0 400 420"
            >
              <defs>
                <linearGradient id="c3-brass" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0" stop-color="#f1dfae"></stop>
                  <stop offset="0.35" stop-color="#c9a764"></stop>
                  <stop offset="0.6" stop-color="#8f6f35"></stop>
                  <stop offset="1" stop-color="#e3c98c"></stop>
                </linearGradient>
                <radialGradient cx="42%" cy="36%" id="c3-glass" r="70%">
                  <stop offset="0" stop-color="#ffffff"></stop>
                  <stop offset="0.7" stop-color="#eef6f3"></stop>
                  <stop offset="1" stop-color="#d6e8e2"></stop>
                </radialGradient>
                <radialGradient id="c3-shadow">
                  <stop
                    offset="0"
                    stop-color="#2e2414"
                    stop-opacity="0.32"
                  ></stop>
                  <stop offset="1" stop-color="#2e2414" stop-opacity="0"></stop>
                </radialGradient>
              </defs>
              <ellipse
                cx="200"
                cy="392"
                fill="url(#c3-shadow)"
                rx="150"
                ry="18"
              ></ellipse>
              <rect
                fill="url(#c3-brass)"
                height="22"
                rx="5"
                width="20"
                x="346"
                y="189"
              ></rect>
              <circle
                cx="200"
                cy="200"
                fill="url(#c3-glass)"
                r="152"
                stroke="url(#c3-brass)"
                stroke-width="26"
              ></circle>
              <circle
                cx="200"
                cy="200"
                fill="none"
                r="136"
                stroke="#a68448"
                stroke-opacity="0.7"
                stroke-width="1"
              ></circle>
              <g fill="#b8955a">
                {markers.slice(1).map((angle) => (
                  <rect
                    height="17"
                    rx="1.5"
                    transform={`rotate(${angle} 200 200)`}
                    width="4"
                    x="198"
                    y="76"
                  />
                ))}
              </g>
              <path d="M200 72 205 84.5 200 97 195 84.5Z" fill="#1f5c57"></path>
              <g
                fill="#ffffff"
                fill-opacity="0.6"
                stroke="#a68448"
                stroke-width="2"
              >
                <rect height="88" width="88" x="156" y="156"></rect>
                <rect
                  height="88"
                  transform="rotate(45 200 200)"
                  width="88"
                  x="156"
                  y="156"
                ></rect>
              </g>
              <g transform={`rotate(${QIBLA_BEARING} 200 200)`}>
                <path d="M200 92 205.5 200h-11Z" fill="#1f5c57"></path>
                <path d="M194.5 200h11L200 244Z" fill="url(#c3-brass)"></path>
              </g>
              <circle cx="200" cy="200" fill="url(#c3-brass)" r="8"></circle>
              <path
                d="M108 150a104 104 0 0 1 64-60"
                fill="none"
                opacity="0.9"
                stroke="#ffffff"
                stroke-linecap="round"
                stroke-width="7"
              ></path>
            </svg>
            <canvas aria-hidden="true" class="stage__canvas"></canvas>
            <p class="stage__qibla">
              <svg aria-hidden="true" viewBox="0 0 16 16">
                <circle
                  cx="8"
                  cy="8"
                  fill="none"
                  r="6.5"
                  stroke="currentColor"
                ></circle>
                <path
                  d="M8 3.5 9.3 8 8 12.5 6.7 8Z"
                  fill="currentColor"
                  transform="rotate(161 8 8)"
                ></path>
              </svg>
              اتجاه القبلة من عمّان {digits.format(QIBLA_BEARING)}°
            </p>
          </div>
        </div>

        <section
          aria-labelledby="features-title"
          class="features"
          id="features"
        >
          <h2 class="section-title" id="features-title">
            ما تفعله الساعة لك
          </h2>
          <ul class="features__list">
            {features.map((feature) => (
              <li class="feature" data-pose={feature.icon}>
                <svg
                  aria-hidden="true"
                  class="feature__icon"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.4"
                  viewBox="0 0 24 24"
                >
                  {(ICONS.get(feature.icon) ?? []).map((path) => (
                    <path d={path} />
                  ))}
                </svg>
                <h3 class="feature__title">{feature.title}</h3>
                <p class="feature__text">{feature.text}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <section
        aria-labelledby="collection-title"
        class="collection"
        id="collection"
      >
        <div class="collection__head">
          <h2 class="section-title" id="collection-title">
            التشكيلة
          </h2>
          <p class="collection__count">
            {digits.format(products.length)} قطع أصلية من الحرمين
          </p>
          <div class="collection__controls">
            <button
              aria-controls="strip"
              class="strip-button"
              data-strip="-1"
              type="button"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="m9 6 6 6-6 6"></path>
              </svg>
              <span class="visually-hidden">الساعات السابقة</span>
            </button>
            <button
              aria-controls="strip"
              class="strip-button"
              data-strip="1"
              type="button"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="m15 6-6 6 6 6"></path>
              </svg>
              <span class="visually-hidden">الساعات التالية</span>
            </button>
          </div>
        </div>

        <div
          aria-label="شريط الساعات"
          class="strip"
          id="strip"
          role="region"
          tabindex="0"
        >
          <ul class="strip__list">
            {products.map((product) => {
              const [cover] = product.data.images;
              const { compareAtPrice, currency, model, name, price } =
                product.data;

              return (
                <li class="strip__item">
                  <article class="card">
                    <div class="card__plate">
                      <Picture
                        alt={cover.alt}
                        class="card__image"
                        formats={["avif", "webp"]}
                        height={CARD_IMAGE}
                        loading="lazy"
                        sizes="(min-width: 60rem) 22rem, 75vw"
                        src={cover.src}
                        width={CARD_IMAGE}
                        widths={[320, 480, CARD_IMAGE]}
                      />
                    </div>
                    <div class="card__body">
                      <p class="card__category">{categoryName(product)}</p>
                      <h3 class="card__name">
                        <a class="card__link" href={`/watches/${product.id}/`}>
                          {name}
                        </a>
                      </h3>
                      <p class="card__meta">
                        <span class="card__price">
                          <span class="visually-hidden">السعر:</span>
                          {formatPrice(price, currency)}
                        </span>
                        {compareAtPrice !== undefined && (
                          <s class="card__was">
                            <span class="visually-hidden">بدلًا من</span>
                            {formatPrice(compareAtPrice, currency)}
                          </s>
                        )}
                        <span class="card__model" dir="ltr">
                          {model}
                        </span>
                      </p>
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <section aria-labelledby="order-title" class="order" id="order">
        <h2 class="section-title" id="order-title">
          الطلب في ثلاث خطوات
        </h2>
        <ol class="steps">
          {steps.map((step, index) => (
            <li class="step">
              <span aria-hidden="true" class="step__number">
                {digits.format(index + 1)}
              </span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </li>
          ))}
        </ol>

        <div class="delivery">
          <h3 class="delivery__title">التوصيل والدفع</h3>
          <table class="zones">
            <caption class="visually-hidden">
              رسوم التوصيل ومدته حسب المنطقة
            </caption>
            <thead>
              <tr>
                <th scope="col">المنطقة</th>
                <th scope="col">رسوم التوصيل</th>
                <th scope="col">مدة التوصيل</th>
              </tr>
            </thead>
            <tbody>
              {zones.map((zone) => (
                <tr>
                  <th scope="row">{zone.data.name}</th>
                  <td class="zones__fee">
                    {formatPrice(zone.data.fee, zone.data.currency)}
                  </td>
                  <td>{deliveryTime(zone.data.minDays, zone.data.maxDays)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="cash">
            <svg
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path d="M3 7h18v10H3Z"></path>
              <path d="M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z"></path>
            </svg>
            الدفع نقدًا عند الاستلام
          </p>
        </div>
      </section>

      <section aria-labelledby="contact-title" class="contact">
        <svg aria-hidden="true" class="contact__ring" viewBox="0 0 120 120">
          <circle
            cx="60"
            cy="60"
            fill="none"
            r="52"
            stroke="currentColor"
            stroke-width="1"
          ></circle>
          <circle
            cx="60"
            cy="60"
            fill="none"
            r="44"
            stroke="currentColor"
            stroke-width="0.5"
          ></circle>
          <path
            d="M60 20 64 60 60 100 56 60Z"
            fill="#1f5c57"
            transform={`rotate(${QIBLA_BEARING} 60 60)`}
          ></path>
        </svg>
        <h2 class="contact__title" id="contact-title">
          اسألنا قبل أن تطلب
        </h2>
        <p class="contact__text">
          نجيبك على واتساب عن الموديلات والألوان وموعد التوصيل، ونجهّز طلبك معك.
        </p>
        <div class="contact__actions">
          <a
            class="button button--solid"
            href={chatUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            راسلنا على واتساب
            <span class="visually-hidden">{NEW_WINDOW}</span>
          </a>
          <a class="contact__phone" href={phoneHref}>
            <span class="visually-hidden">اتصل بنا:</span>
            <span dir="ltr">{store.contact.phone}</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="colophon">
      <p>{store.name}</p>
      <p>{store.contact.address}</p>
      <p>© {year}</p>
    </footer>

    <script>
      import type { Crystal } from "../lib/style-3-scene";

      const REDUCED_MOTION = "(prefers-reduced-motion: reduce)";
      const PRELOAD_MARGIN = "240px";
      const QIBLA_WINDOW = 0.45;

      const hasWebGL2 = (): boolean => {
        try {
          const probe = document.createElement("canvas").getContext("webgl2");
          probe?.getExtension("WEBGL_lose_context")?.loseContext();

          return probe !== null;
        } catch {
          return false;
        }
      };

      /** Fractional section index: 0 while the hero is centred, 1 at the first feature… */
      const readPose = (anchors: readonly HTMLElement[]): number => {
        const middle = window.innerHeight / 2;

        const centers = anchors.map((anchor) => {
          const rect = anchor.getBoundingClientRect();

          return rect.top + rect.height / 2;
        });

        let pose = 0;

        for (const [index, center] of centers.entries()) {
          const next = centers.at(index + 1);

          if (center > middle) {
            break;
          }

          pose =
            next === undefined
              ? index
              : index + Math.min(1, (middle - center) / (next - center));
        }

        return pose;
      };

      const setupStrip = (): void => {
        const strip = document.querySelector<HTMLElement>("#strip");

        if (!strip) {
          return;
        }

        const buttons = [
          ...document.querySelectorAll<HTMLButtonElement>("[data-strip]"),
        ];

        const update = (): void => {
          const travelled = Math.abs(strip.scrollLeft);
          const room = strip.scrollWidth - strip.clientWidth - 1;

          for (const button of buttons) {
            const forward = button.dataset.strip === "1";
            button.disabled = forward ? travelled >= room : travelled <= 1;
          }
        };

        for (const button of buttons) {
          button.addEventListener("click", () => {
            const rtl = getComputedStyle(strip).direction === "rtl" ? -1 : 1;
            const step = Number(button.dataset.strip) * strip.clientWidth * 0.8;
            strip.scrollBy({ left: step * rtl });
          });
        }

        strip.addEventListener("scroll", update, { passive: true });
        update();
      };

      const setupCrystal = (): void => {
        const stage = document.querySelector<HTMLElement>("[data-crystal]");
        const canvas = stage?.querySelector("canvas");
        const fallback = stage?.querySelector("svg");

        if (!stage || !canvas || !fallback) {
          return;
        }

        if (window.matchMedia(REDUCED_MOTION).matches || !hasWebGL2()) {
          return;
        }

        const names = (stage.dataset.poses ?? "hero").split(" ");

        const anchors = names
          .map((name) =>
            document.querySelector<HTMLElement>(`[data-pose="${name}"]`)
          )
          .filter((anchor): anchor is HTMLElement => anchor !== null);

        const qiblaIndex = names.indexOf("qibla");

        let crystal: Crystal | null = null;
        let requested = false;
        let inView = false;
        let frame = 0;

        const sync = (): void => {
          if (!crystal) {
            return;
          }

          if (inView && document.visibilityState === "visible") {
            crystal.start();
          } else {
            crystal.stop();
          }
        };

        const follow = (): void => {
          frame = 0;
          const pose = readPose(anchors);
          crystal?.setPose(pose);
          stage.dataset.qibla = String(
            qiblaIndex !== -1 && Math.abs(pose - qiblaIndex) < QIBLA_WINDOW
          );
        };

        const onScroll = (): void => {
          if (frame === 0) {
            frame = requestAnimationFrame(follow);
          }
        };

        const load = async (): Promise<void> => {
          requested = true;

          try {
            const { createCrystal } = await import("../lib/style-3-scene");
            crystal = createCrystal(canvas, stage, names);
            stage.dataset.state = "live";
            follow();
          } catch {
            // Keep the SVG crystal if three.js or WebGL fails.
            stage.dataset.state = "static";
          }

          sync();
        };

        const observer = new IntersectionObserver(
          (entries) => {
            inView = entries.some((entry) => entry.isIntersecting);

            if (inView && !requested) {
              load();

              return;
            }

            sync();
          },
          { rootMargin: PRELOAD_MARGIN }
        );

        observer.observe(stage);
        window.addEventListener("scroll", onScroll, { passive: true });
        document.addEventListener("visibilitychange", sync);
        window.addEventListener("pagehide", (event) => {
          if (event.persisted) {
            crystal?.stop();

            return;
          }

          observer.disconnect();
          window.removeEventListener("scroll", onScroll);
          crystal?.dispose();
          crystal = null;
        });
      };

      setupStrip();

      setupCrystal();
    </script>

    <style is:global>
      :root {
        --white: #ffffff;
        --stone: #f3f0ea;
        --ink: #161616;
        --ink-soft: #4b4740;
        --brass: #a68448;
        --brass-text: #7a5f2c;
        --tile: #1f5c57;
        --tile-deep: #174641;
        --hairline: rgb(166 132 72 / 0.45);
        --font-display: "El Messiri Variable", "IBM Plex Sans Arabic", serif;
        --font-ui: "IBM Plex Sans Arabic", system-ui, sans-serif;
        --gutter: clamp(1rem, 4vw, 3.5rem);
        --measure: 34rem;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);

        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--white);
        color: var(--ink);
        font-family: var(--font-ui);
        font-size: 1.0625rem;
        line-height: 1.75;
      }

      h1,
      h2,
      h3,
      p,
      ul,
      ol,
      figure {
        margin: 0;
      }

      ul,
      ol {
        padding: 0;
        list-style: none;
      }

      img,
      svg,
      canvas {
        display: block;
        max-inline-size: 100%;
      }

      a {
        color: inherit;
      }

      :focus-visible {
        outline: 2px solid var(--tile);
        outline-offset: 3px;
        border-radius: 2px;
      }

      @media (prefers-reduced-motion: no-preference) {
        html {
          scroll-behavior: smooth;
        }
      }
    </style>

    <style>
      .visually-hidden {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .skip {
        position: absolute;
        inset-block-start: 0.75rem;
        inset-inline-start: 0.75rem;
        z-index: 10;
        padding: 0.5rem 1rem;
        background: var(--white);
        color: var(--ink);
        translate: 0 -200%;
      }

      .skip:focus-visible {
        translate: 0 0;
      }

      /* ---------- Masthead ---------- */

      .masthead {
        display: flex;
        align-items: center;
        gap: 2rem;
        max-inline-size: 90rem;
        margin-inline: auto;
        padding-block: 1.25rem;
        padding-inline: var(--gutter);
        border-block-end: 1px solid var(--hairline);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        text-decoration: none;
      }

      .brand__mark {
        inline-size: 1.75rem;
        color: var(--brass);
      }

      .masthead__nav {
        display: flex;
        gap: 1.75rem;
        margin-inline-start: auto;
        font-size: 0.95rem;
      }

      .masthead__nav a,
      .masthead__chat {
        color: var(--ink-soft);
        text-decoration: none;
        text-underline-offset: 0.45em;
      }

      .masthead__nav a:hover,
      .masthead__chat:hover {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--brass);
      }

      .masthead__chat {
        padding-block: 0.35rem;
        padding-inline: 1rem;
        border: 1px solid var(--brass);
        border-radius: 999px;
        color: var(--ink);
        font-weight: 500;
      }

      @media (width < 48rem) {
        .masthead__nav {
          display: none;
        }

        .masthead__chat {
          margin-inline-start: auto;
        }
      }

      /* ---------- Vitrine: hero + features beside a sticky crystal ---------- */

      .vitrine {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        column-gap: clamp(2rem, 5vw, 6rem);
        max-inline-size: 90rem;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .hero {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
        grid-column: 1;
        grid-row: 1;
        min-block-size: calc(100svh - 5rem);
        padding-block: 3rem;
      }

      .hero__title {
        max-inline-size: 13ch;
        font-family: var(--font-display);
        font-size: clamp(2.4rem, 1.4rem + 3vw, 4.25rem);
        font-weight: 600;
        line-height: 1.22;
        text-wrap: balance;
      }

      .hero__lede {
        max-inline-size: var(--measure);
        color: var(--ink-soft);
        font-size: 1.125rem;
        text-wrap: pretty;
      }

      .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-block-size: 3.25rem;
        padding-inline: 1.75rem;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition:
          background-color 200ms var(--ease),
          border-color 200ms var(--ease);
      }

      .button--solid {
        background: var(--tile);
        color: var(--white);
      }

      .button--solid:hover {
        background: var(--tile-deep);
      }

      .button--line {
        border-color: var(--ink);
        color: var(--ink);
      }

      .button--line:hover {
        border-color: var(--brass);
        background: var(--stone);
      }

      /* The real watch, displayed like a gallery specimen with its label. */
      .specimen {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-block-start: 1rem;
        padding-block-start: 1.5rem;
        border-block-start: 1px solid var(--hairline);
      }

      .specimen__plate {
        flex: none;
        inline-size: clamp(8rem, 13vw, 11rem);
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 50%;
        background: var(--stone);
      }

      .specimen__image {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        mix-blend-mode: multiply;
        scale: 1.06;
      }

      .specimen__category,
      .card__category {
        color: var(--brass-text);
        font-size: 0.875rem;
        font-weight: 500;
      }

      .specimen__name {
        font-family: var(--font-display);
        font-size: 1.3rem;
        font-weight: 600;
        line-height: 1.45;
      }

      .specimen__name a {
        text-decoration: none;
      }

      .specimen__name a::after {
        position: absolute;
        inset: 0;
        content: "";
      }

      .specimen:has(a:focus-visible) {
        outline: 2px solid var(--tile);
        outline-offset: 6px;
      }

      .specimen__name a:focus-visible {
        outline: none;
      }

      .specimen__name a:hover {
        text-decoration: underline;
        text-decoration-color: var(--brass);
      }

      .specimen__price {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-block-start: 0.35rem;
        font-size: 1.125rem;
        font-weight: 600;
      }

      .specimen__price s,
      .card__was {
        color: var(--ink-soft);
        font-weight: 400;
      }

      /* The stage spans the hero and every feature; its inner box sticks. */
      .stage-column {
        grid-column: 2;
        grid-row: 1 / span 2;
      }

      .stage {
        position: sticky;
        inset-block-start: 0;
        display: grid;
        place-items: center;
        block-size: 100svh;
        background: var(--white);
      }

      .stage__fallback,
      .stage__canvas {
        grid-area: 1 / 1;
        transition: opacity 900ms var(--ease);
      }

      .stage__fallback {
        inline-size: min(78%, 62svh);
        block-size: auto;
      }

      .stage__canvas {
        inline-size: 100%;
        block-size: 100%;
        opacity: 0;
      }

      .stage[data-state="live"] .stage__canvas {
        opacity: 1;
        transition-delay: 150ms;
      }

      .stage[data-state="live"] .stage__fallback {
        opacity: 0;
        transition-duration: 250ms;
      }

      .stage__qibla {
        position: absolute;
        inset-block-end: 9%;
        inset-inline: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: var(--tile);
        font-size: 0.95rem;
        font-weight: 500;
        transition:
          opacity 500ms var(--ease),
          translate 500ms var(--ease);
      }

      .stage__qibla svg {
        inline-size: 1.1rem;
      }

      /* Live, the label only shows while the needle points at the Qibla. */
      .stage[data-state="live"]:not([data-qibla="true"]) .stage__qibla {
        opacity: 0;
        translate: 0 0.5rem;
      }

      .features {
        grid-column: 1;
        grid-row: 2;
        padding-block: 2rem 30svh;
      }

      .section-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
        font-weight: 600;
        line-height: 1.3;
      }

      .feature {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.9rem;
        min-block-size: 64svh;
        max-inline-size: var(--measure);
      }

      .feature__icon {
        inline-size: 2.75rem;
        color: var(--brass);
      }

      .feature__title {
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.25rem);
        font-weight: 600;
        line-height: 1.35;
      }

      .feature__title::after {
        display: block;
        inline-size: 6rem;
        block-size: 1px;
        margin-block-start: 1rem;
        background: var(--brass);
        content: "";
        transform-origin: right center;
      }

      .feature__text {
        color: var(--ink-soft);
        font-size: 1.125rem;
      }

      @media (width < 60rem) {
        .vitrine {
          display: block;
          padding-inline: 0;
        }

        .hero,
        .features {
          padding-inline: var(--gutter);
        }

        .hero {
          min-block-size: auto;
          padding-block: 2.5rem 3rem;
        }

        /* On phones the crystal sticks to the top while the features pass under it. */
        .stage-column {
          display: contents;
        }

        .stage {
          z-index: 2;
          block-size: 46svh;
          border-block-end: 1px solid var(--hairline);
        }

        .stage__fallback {
          inline-size: auto;
          block-size: 84%;
        }

        .stage__qibla {
          inset-block-end: 0.5rem;
          font-size: 0.875rem;
        }

        .features {
          padding-block: 3rem 20svh;
        }

        .feature {
          min-block-size: 46svh;
        }
      }

      /* ---------- Collection filmstrip ---------- */

      .collection {
        padding-block: clamp(4rem, 9vw, 8rem);
        border-block-start: 1px solid var(--hairline);
      }

      .collection__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1.5rem;
        max-inline-size: 90rem;
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .collection__count {
        color: var(--ink-soft);
      }

      .collection__controls {
        display: flex;
        gap: 0.5rem;
        margin-inline-start: auto;
      }

      .strip-button {
        display: grid;
        place-items: center;
        inline-size: 3rem;
        block-size: 3rem;
        padding: 0;
        border: 1px solid var(--brass);
        border-radius: 50%;
        background: var(--white);
        color: var(--ink);
        cursor: pointer;
        transition: background-color 200ms var(--ease);
      }

      .strip-button:hover:not(:disabled) {
        background: var(--stone);
      }

      .strip-button:disabled {
        border-color: #c9bfae;
        color: #8c857a;
        cursor: default;
      }

      .strip-button svg {
        inline-size: 1.25rem;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.6;
      }

      .strip {
        margin-block-start: 2.5rem;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-padding-inline: var(--gutter);
        scroll-snap-type: x mandatory;
        scrollbar-color: var(--brass) var(--stone);
        scrollbar-width: thin;
      }

      .strip:focus-visible {
        outline-offset: -2px;
      }

      .strip__list {
        display: flex;
        gap: clamp(1rem, 2vw, 2rem);
        inline-size: max-content;
        padding-block: 1.5rem 2.5rem;
        padding-inline: var(--gutter);
      }

      .strip__item {
        inline-size: clamp(16rem, 72vw, 22rem);
        scroll-snap-align: start;
      }

      .card {
        position: relative;
        display: flex;
        flex-direction: column;
        block-size: 100%;
        border: 1px solid #e7e0d2;
        border-radius: 1.25rem;
        background: var(--white);
        transition:
          transform 600ms var(--ease),
          box-shadow 600ms var(--ease),
          border-color 300ms var(--ease);
      }

      .card__plate {
        margin: 0.75rem;
        overflow: hidden;
        border-radius: 0.85rem;
        background: var(--stone);
        aspect-ratio: 1;
      }

      .card__image {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
        mix-blend-mode: multiply;
        transition: scale 700ms var(--ease);
      }

      .card__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.3rem;
        padding-block: 0.5rem 1.5rem;
        padding-inline: 1.5rem;
      }

      .card__name {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.45;
      }

      .card__link {
        text-decoration: none;
      }

      .card__link::after {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        content: "";
      }

      .card:has(.card__link:focus-visible) {
        outline: 2px solid var(--tile);
        outline-offset: 3px;
      }

      .card__link:focus-visible {
        outline: none;
      }

      .card__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.4rem 0.75rem;
        margin-block-start: auto;
        padding-block-start: 0.85rem;
        border-block-start: 1px solid #ece6da;
      }

      .card__price {
        font-size: 1.15rem;
        font-weight: 600;
      }

      .card__model {
        margin-inline-start: auto;
        color: var(--brass-text);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
      }

      .card:hover {
        border-color: var(--brass);
      }

      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .card:hover {
          box-shadow: 0 2rem 3rem -2rem rgb(70 52 20 / 0.35);
          transform: perspective(70rem) rotateX(4deg) rotateY(-6deg)
            translateY(-0.35rem);
        }

        .card:hover .card__image {
          scale: 1.05;
        }
      }

      /* ---------- Order ---------- */

      .order {
        padding-block: clamp(4rem, 9vw, 8rem);
        padding-inline: max(
          var(--gutter),
          calc((100% - 90rem) / 2 + var(--gutter))
        );
        background: var(--stone);
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 2.5rem clamp(2rem, 4vw, 4rem);
        margin-block-start: 3rem;
        counter-reset: step;
      }

      .step {
        display: grid;
        gap: 0.5rem;
        padding-block-start: 1.25rem;
        border-block-start: 1px solid var(--hairline);
      }

      .step__number {
        color: var(--brass-text);
        font-family: var(--font-display);
        font-size: 3.25rem;
        font-weight: 500;
        line-height: 1;
      }

      .step__title {
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 600;
      }

      .step__text {
        max-inline-size: 26rem;
        color: var(--ink-soft);
      }

      .delivery {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        gap: 1.5rem clamp(2rem, 4vw, 4rem);
        align-items: start;
        margin-block-start: clamp(3.5rem, 7vw, 6rem);
        padding: clamp(1.5rem, 3vw, 2.5rem);
        border-radius: 1.25rem;
        background: var(--white);
      }

      .delivery__title {
        font-family: var(--font-display);
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.3;
      }

      .zones {
        inline-size: 100%;
        border-collapse: collapse;
        grid-column: 2;
        grid-row: 1 / span 2;
      }

      .zones th,
      .zones td {
        padding-block: 0.9rem;
        padding-inline: 0 1rem;
        border-block-end: 1px solid #ece6da;
        text-align: start;
      }

      .zones thead th {
        padding-block-start: 0;
        color: var(--ink-soft);
        font-size: 0.875rem;
        font-weight: 500;
      }

      .zones tbody th {
        font-weight: 600;
      }

      .zones__fee {
        font-weight: 600;
      }

      .cash {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--tile);
        font-weight: 600;
      }

      .cash svg {
        inline-size: 1.5rem;
      }

      @media (width < 40rem) {
        .delivery {
          grid-template-columns: minmax(0, 1fr);
        }

        .zones {
          grid-column: 1;
          grid-row: auto;
          font-size: 0.95rem;
        }
      }

      /* ---------- Contact ---------- */

      .contact {
        display: grid;
        justify-items: center;
        gap: 1.25rem;
        padding-block: clamp(5rem, 10vw, 9rem);
        padding-inline: var(--gutter);
        text-align: center;
      }

      .contact__ring {
        inline-size: 4.5rem;
        color: var(--brass);
      }

      .contact__title {
        font-family: var(--font-display);
        font-size: clamp(2.2rem, 1.5rem + 2.4vw, 3.5rem);
        font-weight: 600;
        line-height: 1.25;
      }

      .contact__text {
        max-inline-size: 30rem;
        color: var(--ink-soft);
        font-size: 1.125rem;
      }

      .contact__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 1rem 1.75rem;
        margin-block-start: 0.75rem;
      }

      .contact__phone {
        font-size: 1.2rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-decoration-color: var(--brass);
        text-underline-offset: 0.35em;
      }

      .colophon {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 2rem;
        max-inline-size: 90rem;
        margin-inline: auto;
        padding-block: 2rem 2.5rem;
        padding-inline: var(--gutter);
        border-block-start: 1px solid var(--hairline);
        color: var(--ink-soft);
        font-size: 0.9rem;
      }

      /* ---------- Scroll-driven details ---------- */

      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          /* Each feature's brass rule draws in as it reaches the centre. */
          .feature__title::after {
            animation-name: c3-rule;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-range: entry 40% cover 45%;
            animation-timeline: view();
          }

          /* The hero eases back as the crystal takes over. */
          .hero > * {
            animation-name: c3-recede;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-range: exit 30% exit 100%;
            animation-timeline: view();
          }
        }
      }

      @keyframes c3-rule {
        from {
          scale: 0 1;
        }
      }

      @keyframes c3-recede {
        to {
          opacity: 0.25;
          translate: 0 -2rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </body>
