---
import { getCollection } from "astro:content";

import VideoGrid from "../components/VideoGrid.astro";
import Layout from "../layouts/Layout.astro";

const entries = await getCollection("guides");
const guides = entries.toSorted((a, b) => a.data.order - b.data.order);
---

<Layout
  description="فيديوهات رسمية من الحرمين تشرح ضبط الوقت والمدينة والأذان والإقامة وباقي مزايا ساعتك."
  title="شروحات الاستعمال"
>
  <main class="guides container" id="main">
    <header class="guides__intro">
      <h1>شروحات الاستعمال</h1>
      <p class="guides__lead">
        فيديوهات رسمية من الحرمين تشرح كل خطوة في ضبط ساعتك. ابدأ بضبط الوقت
        والتاريخ والمدينة، ثم اضبط الأذان والإقامة.
      </p>
    </header>

    {guides.map(({ id, data }) => (
      <section aria-labelledby={`${id}-title`} class="guides__family" id={id}>
        <div class="section-head">
          <h2 id={`${id}-title`}>{data.name}</h2>
          <p class="guides__models">
            الموديلات: <span dir="ltr">{data.models.join(" · ")}</span>
          </p>
        </div>
        <VideoGrid videos={data.videos} />
      </section>
    ))}
  </main>
</Layout>

<style>
  .guides {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section);
  }

  .guides__intro {
    margin-block-end: clamp(2.5rem, 6vw, 4rem);
  }

  .guides__lead {
    max-inline-size: 36rem;
    margin-block-start: var(--space-3);
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
  }

  .guides__family {
    padding-block-start: var(--space-5);
    border-block-start: 1px solid var(--ink);
  }

  .guides__family + .guides__family {
    margin-block-start: var(--section);
  }

  .guides__models {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .guides__models span {
    unicode-bidi: isolate;
  }
</style>
