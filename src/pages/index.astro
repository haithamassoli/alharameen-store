---
// The home page, «التشريح»: one big watch holds the screen while scrolling
// draws its five features out of it, one leader line at a time, until they
// settle into a calm technical drawing. CSS scroll-driven animations do the
// work; src/lib/anatomy.ts steps through the same states where they are not
// supported. Below it: the catalog, the FAQ, and contact.
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";

import ProductCard from "../components/ProductCard.astro";
import Layout from "../layouts/Layout.astro";
import { hijriToday } from "../lib/anatomy";
import { whatsappUrl } from "../lib/cart";
import { deliveryTime } from "../lib/delivery";
import { formatNumber, formatPrice } from "../lib/money";
import { getShippingZones, getStore } from "../lib/store";

const store = await getStore();

const categoryEntries = await getCollection("categories");

const categoryById = new Map(
  categoryEntries.map((entry) => [entry.id, entry.data])
);

const categoryOrder = (id: string): number => categoryById.get(id)?.order ?? 0;

// Category order first, then featured pieces, then cheapest first.
const allProducts = await getCollection("products");

const products = allProducts.toSorted(
  (a, b) =>
    categoryOrder(a.data.category.id) - categoryOrder(b.data.category.id) ||
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.price - b.data.price
);

const categoryName = (id: string): string => categoryById.get(id)?.name ?? "";

const zones = await getShippingZones();

const { contact, returnDays, warrantyYears } = store;

const WARRANTY_WORDS = new Map([
  [1, "سنة كاملة"],
  [2, "سنتين"],
]);

const warranty =
  WARRANTY_WORDS.get(warrantyYears) ?? `${formatNumber(warrantyYears)} سنوات`;

const giftWrapFee = formatPrice(store.giftWrap.fee, store.giftWrap.currency);

const chatUrl = whatsappUrl(
  contact.whatsapp,
  "السلام عليكم، أرغب بالاستفسار عن ساعات الحرمين."
);

const steps = [
  { text: "تصفّح التشكيلة واختر الساعة التي تناسبك.", title: "اختر ساعتك" },
  { text: "أضف ما تريد إلى السلة واختر منطقة التوصيل.", title: "أضفها للسلة" },
  {
    text: "نجهّز لك رسالة الطلب، أرسلها ونؤكد معك موعد التوصيل.",
    title: "أرسل الطلب عبر واتساب",
  },
] as const;

// Who each piece suits as a gift. In the scroll story each one takes its
// turn on the gift tag, sharing the scroll after the tag hangs.
const IDEAS_START = 36;

const giftIdeas = [
  {
    text: "تؤذن بالأذان كاملًا بصوت واضح، وتعرض مواقيت اليوم كلها على شاشة واحدة.",
    title: "للوالدين",
  },
  {
    text: "خفيفة ومتينة تنبّههم لكل صلاة، بالأسود والأبيض والوردي.",
    title: "للأبناء عند سن الصلاة",
  },
  {
    text: "تحدد القبلة وتعرض مواقيت مدن العالم، فترافقه في سفره.",
    title: "للحاج والمعتمر",
  },
  { text: "ستانلس ستيل ذهبي وزجاج ياقوتي مضاد للخدش.", title: "لها" },
  {
    text: "يردّد أذكار الدخول والخروج كلما فُتح الباب.",
    title: "للبيت الجديد",
  },
] as const;

const IDEA_SPAN = (100 - IDEAS_START) / giftIdeas.length;

const HERO_SIZE = 992;
const JORDAN_PHONE = /^\+962(?<area>\d{2})(?<mid>\d{3})(?<end>\d{4})$/u;

// The black sport watch: its screen shows the date and its bezel the
// compass letters, so every annotation has a real detail to point at.
const ANATOMY_WATCH = "ha-6506bw";

const hero =
  products.find((product) => product.id === ANATOMY_WATCH) ??
  products.find((product) => product.data.featured) ??
  products[0];

if (!hero) {
  throw new Error("The home page needs at least one product.");
}

const [heroImage] = hero.data.images;

// The gold and silver pieces from the share card flank the black watch on
// its inline-end side (the intro owns the other), then step away on scroll.
const COMPANIONS = ["ha-6314fgw", "ha-6208fsw"] as const;

const companions = COMPANIONS.map((id) => {
  const image = allProducts.find((product) => product.id === id)?.data
    .images[0];

  if (!image) {
    throw new Error(`Hero companion points at a missing product: ${id}`);
  }

  return { id, image };
});

// ---- The drawing ----
// Coordinates are in the photo's own 1000 × 1000 box, measured on
// ha-6506bw-1.webp. The drawing is 1600 wide, so the photo sits between
// x = 0 and x = 1000 with 300 units of margin on either side.
const NOTE_EDGE = { left: 230, right: 770 } as const;
const ELBOW = 50;
const PERCENT_PER_UNIT = 0.1;

type Side = keyof typeof NOTE_EDGE;

interface Feature {
  /** The detail the leader points at. */
  anchor: readonly [number, number];
  /** The calendar note also shows today's Hijri date. */
  hijri?: true;
  side: Side;
  text: string;
  title: string;
  /** Height of the note's top rule. */
  y: number;
}

const features: Feature[] = [
  {
    // The prayer-time row at the foot of the screen.
    anchor: [442, 551],
    side: "left",
    text: "مواقيت دقيقة لمعظم مدن العالم، ومنبّه لكل صلاة يتغير تلقائيًا مع وقت الأذان.",
    title: "أوقات الأذان لكل مدن العالم",
    y: 720,
  },
  {
    // The SE letter on the compass bezel.
    anchor: [610, 591],
    side: "right",
    text: "بوصلة إلكترونية تدلّك على القبلة أينما كنت، بضغطة زر واحدة.",
    title: "اتجاه القبلة",
    y: 640,
  },
  {
    // The date at the top of the screen.
    anchor: [591, 387],
    hijri: true,
    side: "right",
    text: "التاريخ الهجري والميلادي وأيام الأسبوع معًا على شاشة واحدة.",
    title: "تقويم هجري",
    y: 387,
  },
  {
    // The sealed case, at its shoulder above the bezel.
    anchor: [343, 251],
    side: "left",
    text: "توضّأ وهي في يدك، وزجاجها البلوري مضاد للخدش.",
    title: "مقاومة للماء",
    y: 251,
  },
  {
    // The big digits, where the surah and ayah show.
    anchor: [418, 458],
    side: "left",
    text: "احفظ رقم السورة والآية التي وقفت عندها، وأكمل وردك من حيث توقفت.",
    title: "موضع التلاوة",
    y: 470,
  },
];

// ---- The watch screen ----
// A loop of three readouts laid over the photo's LCD. The prayer time and
// the Qibla are examples; the Hijri date is today's.
const FAJR_TIME = "4:52";

// Qibla from Amman, from true north. An example, not a calculation.
const QIBLA_BEARING = 157;

const leaderPath = (
  [x, y]: readonly [number, number],
  side: Side,
  ruleY: number
): string => {
  const edge = NOTE_EDGE[side];
  const elbow = side === "left" ? edge + ELBOW : edge - ELBOW;

  return `M${x} ${y}L${elbow} ${ruleY}H${edge}`;
};

const notes = features.map((feature, index) => ({
  ...feature,
  index: index + 1,
  path: leaderPath(feature.anchor, feature.side, feature.y),
  top: `${feature.y * PERCENT_PER_UNIT}%`,
}));

const categories = [
  ...new Set(products.map((product) => product.data.category.id)),
];

// One rule per category: when its radio is checked, hide every other card.
// Filtering works without JS; the script below only animates the change.
const filterCss = categories
  .map(
    (id) =>
      `.catalog:has(#filter-${id}:checked) .catalog__item:not([data-category="${id}"]){display:none}`
  )
  .join("");

const phoneParts = JORDAN_PHONE.exec(contact.phone)?.groups;

const phoneLabel = phoneParts
  ? `+962 ${phoneParts.area} ${phoneParts.mid} ${phoneParts.end}`
  : contact.phone;

const siteUrl = new URL("/", Astro.site).href;

const storeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": `${siteUrl}#store`,
      "@type": "OnlineStore",
      address: {
        "@type": "PostalAddress",
        addressCountry: "JO",
        addressLocality: contact.address,
      },
      description: store.tagline,
      logo: new URL("/pwa-512x512.png", Astro.site).href,
      name: store.name,
      telephone: contact.phone,
      url: siteUrl,
    },
    {
      "@type": "WebSite",
      inLanguage: "ar",
      name: store.name,
      publisher: { "@id": `${siteUrl}#store` },
      url: siteUrl,
    },
  ],
};
---

<Layout jsonLd={storeJsonLd}>
  <Fragment slot="head">
    <style is:inline set:html={filterCss}></style>
    <!-- Decide before first paint whether the scroll story runs, so the
         layout never jumps. Without JS the hero is a static drawing. -->
    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        document.documentElement.classList.add("scrolly");
      }
    </script>
  </Fragment>

  <main id="main">
    <section aria-labelledby="hero-title" class="anatomy" data-anatomy>
      <div class="stage">
        <div class="drawing">
          <div class="intro">
            <p class="intro__eyebrow">ساعات الحرمين الأصلية في الأردن</p>
            <h1 class="intro__title" id="hero-title">
              لا يفوتك أذان، أينما كنت
            </h1>
            <p class="intro__lede">
              ساعات يد ومكتب تنبّهك لكل صلاة وتدلّك على القبلة. اطلبها عبر واتساب،
              وادفع عند الاستلام.
            </p>
            <div class="intro__actions">
              <a class="btn btn-primary" href="#watches">
                تسوّق الساعات
              </a>
              <a
                class="quiet-link"
                href={chatUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                اسألنا على واتساب
                <span class="visually-hidden">(يفتح في نافذة جديدة)</span>
              </a>
            </div>
            <a class="intro__product" href={`/watches/${hero.id}/`}>
              <span>{hero.data.name}</span>
              <span class="price">
                {formatPrice(hero.data.price, hero.data.currency)}
              </span>
            </a>
          </div>

          <div class="plate">
            <div class="figure">
              <div class="figure__zoom">
                {companions.map(({ id, image }) => (
                  <Picture
                    alt=""
                    fallbackFormat="webp"
                    formats={["avif"]}
                    height={HERO_SIZE}
                    pictureAttributes={{
                      class: "companion",
                      "data-companion": id,
                    }}
                    sizes="(min-width: 56rem) min(58vh, 35rem), 45vw"
                    src={image.src}
                    width={HERO_SIZE}
                    widths={[480, 720]}
                  />
                ))}
                <Picture
                  alt={heroImage.alt}
                  fetchpriority="high"
                  fallbackFormat="webp"
                  formats={["avif"]}
                  height={HERO_SIZE}
                  loading="eager"
                  sizes="(min-width: 56rem) min(82vh, 50rem), 130vw"
                  src={heroImage.src}
                  width={HERO_SIZE}
                  widths={[480, 720, HERO_SIZE]}
                />

                <div aria-hidden="true" class="lcd">
                  <div class="readout" style="--i: 0">
                    <span class="readout__line">
                      <svg class="readout__bell" viewBox="0 0 24 24">
                        <path d="M6 16.5h12l-1.6-2.2V10a4.4 4.4 0 0 0-8.8 0v4.3z" />
                        <path d="M10.2 19a1.9 1.9 0 0 0 3.6 0" />
                      </svg>
                      الفجر
                    </span>
                    <span class="readout__big">{FAJR_TIME}</span>
                    <span class="readout__small">مثال لموعد الأذان</span>
                  </div>

                  <div class="readout" style="--i: 1">
                    <svg
                      class="readout__compass"
                      style={`--bearing: ${QIBLA_BEARING}deg`}
                      viewBox="0 0 40 40"
                    >
                      <circle cx="20" cy="20" r="17" />
                      <g class="readout__needle">
                        <path d="M20 5 23.2 20h-6.4z" />
                        <path class="readout__tail" d="M16.8 20h6.4L20 35z" />
                      </g>
                    </svg>
                    <span class="readout__mid">{QIBLA_BEARING}°</span>
                    <span class="readout__small">القبلة من عمّان</span>
                  </div>

                  <div class="readout" style="--i: 2">
                    <span class="readout__line">هجري</span>
                    <span class="readout__big" data-hijri="day">
                      {hijriToday("day")}
                    </span>
                    <span class="readout__small" data-hijri="month">
                      {hijriToday("month")}
                    </span>
                  </div>
                </div>

                <svg aria-hidden="true" class="marks" viewBox="0 0 1000 1000">
                  {notes.map((note) => (
                    <g
                      class="leader"
                      data-note={note.index}
                      style={`--i: ${note.index}`}
                    >
                      <path class="leader__line" d={note.path} pathLength="1" />
                      <circle
                        class="leader__halo"
                        cx={note.anchor[0]}
                        cy={note.anchor[1]}
                        r="15"
                      />
                      <circle
                        class="leader__dot"
                        cx={note.anchor[0]}
                        cy={note.anchor[1]}
                        r="5.5"
                      />
                    </g>
                  ))}
                </svg>
              </div>
            </div>

            <div class="notes" id="features">
              <h2 class="visually-hidden">مزايا الساعة</h2>
              <ol class="notes__list">
                {notes.map((note) => (
                  <li
                    class="note"
                    data-note={note.index}
                    data-side={note.side}
                    style={`--i: ${note.index}; --y: ${note.top}`}
                  >
                    <h3 class="note__title">{note.title}</h3>
                    <div class="note__body">
                      <p class="note__text">{note.text}</p>
                      {note.hijri && (
                        <p class="note__extra">
                          {/* Rendered at build so it is never empty; the page script refreshes it. */}
                          اليوم <span data-hijri>{hijriToday()}</span>
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>

        <ol aria-hidden="true" class="ticks">
          {notes.map((note) => (
            <li data-note={note.index} style={`--i: ${note.index}`}></li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-labelledby="watches-title" class="catalog" id="watches">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 id="watches-title">الساعات</h2>
            <p class="section-note">
              {formatNumber(products.length)} منتجات، كلها أصلية ومكفولة
            </p>
          </div>

          {categories.length > 1 && (
            <fieldset class="filters">
              <legend class="visually-hidden">تصفية حسب الفئة</legend>
              <label class="chip">
                <input checked name="category" type="radio" value="all" />
                الكل
              </label>
              {categories.map((id) => (
                <label class="chip">
                  <input
                    id={`filter-${id}`}
                    name="category"
                    type="radio"
                    value={id}
                  />
                  {categoryName(id)}
                </label>
              ))}
            </fieldset>
          )}
        </div>

        <ul class="catalog__grid">
          {products.map((product) => (
            <li
              class="catalog__item"
              data-category={product.data.category.id}
              style={`--card: card-${product.id}`}
            >
              <ProductCard
                categoryName={categoryName(product.data.category.id)}
                product={product}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="gifts-title" class="gifts" id="gifts">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 id="gifts-title">«تَهادَوا تَحابُّوا»</h2>
            <p class="section-note">
              هدية يبقى أجرها: ساعة الأذان تذكّر من تحب بالصلاة خمس مرات كل يوم،
              فلعل لك مثل أجره في كل صلاة يدركها على وقتها.
            </p>
          </div>
        </div>
      </div>

      <div class="gifts__story">
        <div class="gifts__stage container">
          <div class="gift">
            <svg
              aria-hidden="true"
              class="gift__drawing"
              viewBox="0 60 320 260"
            >
              <path
                class="gift__box"
                d="M40 112h240v48H40zM56 160h208v120H56z"
                pathLength="1"
              />
              <path
                class="gift__ribbon"
                d="M150 112v168M170 112v168"
                pathLength="1"
              />
              <path
                class="gift__bow"
                d="M160 112c-40-50-82-24-60-6 12 9 40 8 60 6m0 0c40-50 82-24 60-6-12 9-40 8-60 6m0 0l-26 34m26-34l26 34"
                pathLength="1"
              />
              <path
                class="gift__string"
                d="M160 112c-50 40-118 60-128 208"
                pathLength="1"
              />
            </svg>

            <div class="gift__tag">
              <h3 class="gift__tag-title">لمن تناسب</h3>
              <ul class="gift-ideas">
                {giftIdeas.map((idea, index) => (
                  <li
                    class="gift-idea"
                    style={`--from: ${IDEAS_START + index * IDEA_SPAN}%; --to: ${IDEAS_START + (index + 1) * IDEA_SPAN}%`}
                  >
                    <strong class="gift-idea__title">{idea.title}</strong>
                    <span class="gift-idea__text">{idea.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="faq-title" class="faq" id="faq">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 id="faq-title">الأسئلة الشائعة</h2>
            <p class="section-note">
              كل ما تحتاج معرفته قبل أن تطلب، ولا تدفع شيئًا قبل أن تصلك الساعة.
            </p>
          </div>
        </div>

        <div class="faq__list">
          <details class="faq__item" name="faq">
            <summary class="faq__question">كيف أطلب ساعتي؟</summary>
            <div class="faq__answer">
              <ol class="steps">
                {steps.map((step, index) => (
                  <li class="step">
                    <span aria-hidden="true" class="step__number">
                      {formatNumber(index + 1)}
                    </span>
                    <h3 class="step__title">{step.title}</h3>
                    <p class="step__text">{step.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              كم تكلفة التوصيل وكم يستغرق؟
            </summary>
            <div class="faq__answer">
              <p>نوصل لجميع محافظات الأردن، والرسوم حسب المنطقة:</p>
              <table class="zones">
                <caption class="visually-hidden">
                  رسوم التوصيل ومدته حسب المنطقة
                </caption>
                <thead>
                  <tr>
                    <th scope="col">المنطقة</th>
                    <th scope="col">الرسوم</th>
                    <th scope="col">المدة</th>
                  </tr>
                </thead>
                <tbody>
                  {zones.map((zone) => (
                    <tr>
                      <th scope="row">{zone.data.name}</th>
                      <td class="price">
                        {formatPrice(zone.data.fee, zone.data.currency)}
                      </td>
                      <td>
                        {deliveryTime(zone.data.minDays, zone.data.maxDays)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">كيف أدفع؟</summary>
            <div class="faq__answer">
              <p>
                نقدًا عند الاستلام. تدفع ثمن الساعة مع رسوم التوصيل للمندوب حين
                تصلك، ولا نطلب أي دفعة مسبقة.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              هل أستطيع طلب أكثر من ساعة في طلب واحد؟
            </summary>
            <div class="faq__answer">
              <p>
                نعم، أضف ما تشاء إلى السلة، وتُحسب رسوم التوصيل مرة واحدة على
                الطلب كله.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">هل أستطيع إرسالها هدية؟</summary>
            <div class="faq__answer">
              <p>
                نعم. اختر «تغليف هدية» في السلة واكتب نص البطاقة، فنغلّف الطلب
                ونطبع رسالتك على بطاقة مرفقة مقابل {giftWrapFee} للطلب كله.
                ولإرسالها مباشرة لمن تُهديه، اكتب عنوانه في خانة العنوان.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">هل الساعات أصلية؟</summary>
            <div class="faq__answer">
              <p>
                نعم، كل ساعاتنا من الحرمين الأصلية، وكل ساعة مكفولة بضمان
                {warranty}.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              ما الضمان، وهل أستطيع إرجاع الساعة؟
            </summary>
            <div class="faq__answer">
              <p>
                على كل ساعة ضمان {warranty}، ويمكنك إرجاعها خلال{" "}
                {formatNumber(returnDays)} يومًا. راسلنا على واتساب ونرتب معك
                الإرجاع أو الصيانة.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              كيف أضبط الوقت والمدينة ومواقيت الصلاة؟
            </summary>
            <div class="faq__answer">
              <p>
