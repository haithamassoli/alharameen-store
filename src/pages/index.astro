---
// The home page, «التشريح»: one big watch holds the screen while scrolling
// draws its five features out of it, one leader line at a time, until they
// settle into a calm technical drawing. CSS scroll-driven animations do the
// work; src/lib/anatomy.ts steps through the same states where they are not
// supported. Below it: the catalog, the FAQ, and contact.
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";

import ProductCard from "../components/ProductCard.astro";
import Layout from "../layouts/Layout.astro";
import { whatsappUrl } from "../lib/cart";
import { deliveryTime } from "../lib/delivery";
import { formatPrice } from "../lib/money";
import { getShippingZones, getStore } from "../lib/store";

const store = await getStore();

const categoryEntries = await getCollection("categories");

const categoryById = new Map(
  categoryEntries.map((entry) => [entry.id, entry.data])
);

const categoryOrder = (id: string): number => categoryById.get(id)?.order ?? 0;

// Category order first, then featured pieces, then cheapest first.
const allProducts = await getCollection("products");

const products = allProducts.toSorted(
  (a, b) =>
    categoryOrder(a.data.category.id) - categoryOrder(b.data.category.id) ||
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.price - b.data.price
);

const categoryName = (id: string): string => categoryById.get(id)?.name ?? "";

const zones = await getShippingZones();

const digits = new Intl.NumberFormat("ar-JO-u-nu-latn");
const { contact, returnDays, warrantyYears } = store;

const WARRANTY_WORDS = new Map([
  [1, "سنة كاملة"],
  [2, "سنتين"],
]);

const warranty =
  WARRANTY_WORDS.get(warrantyYears) ?? `${digits.format(warrantyYears)} سنوات`;

const chatUrl = whatsappUrl(
  contact.whatsapp,
  "السلام عليكم، أرغب بالاستفسار عن ساعات الحرمين."
);

const features = [
  {
    icon: "azan",
    text: "مواقيت دقيقة لمعظم مدن العالم، ومنبّه لكل صلاة يتغير تلقائيًا مع وقت الأذان.",
    title: "أوقات الأذان لكل مدن العالم",
  },
  {
    icon: "qibla",
    text: "بوصلة إلكترونية تدلّك على القبلة أينما كنت، بضغطة زر واحدة.",
    title: "اتجاه القبلة",
  },
  {
    icon: "calendar",
    text: "التاريخ الهجري والميلادي وأيام الأسبوع معًا على شاشة واحدة.",
    title: "تقويم هجري",
  },
  {
    icon: "water",
    text: "توضّأ وهي في يدك، وزجاجها البلوري مضاد للخدش.",
    title: "مقاومة للماء",
  },
  {
    icon: "quran",
    text: "احفظ رقم السورة والآية التي وقفت عندها، وأكمل وردك من حيث توقفت.",
    title: "موضع التلاوة",
  },
] as const;

const steps = [
  { text: "تصفّح التشكيلة واختر الساعة التي تناسبك.", title: "اختر ساعتك" },
  { text: "أضف ما تريد إلى السلة واختر منطقة التوصيل.", title: "أضفها للسلة" },
  {
    text: "نجهّز لك رسالة الطلب، أرسلها ونؤكد معك موعد التوصيل.",
    title: "أرسل الطلب عبر واتساب",
  },
] as const;

const HERO_SIZE = 992;
const JORDAN_PHONE = /^\+962(?<area>\d{2})(?<mid>\d{3})(?<end>\d{4})$/u;

// The black sport watch: its screen shows the date and its bezel the
// compass letters, so every annotation has a real detail to point at.
const ANATOMY_WATCH = "ha-6506bw";

const hero =
  products.find((product) => product.id === ANATOMY_WATCH) ??
  products.find((product) => product.data.featured) ??
  products[0];

if (!hero) {
  throw new Error("The home page needs at least one product.");
}

const [heroImage] = hero.data.images;

if (!heroImage) {
  throw new Error(`${hero.id} has no photo.`);
}

// ---- The drawing ----
// Coordinates are in the photo's own 1000 × 1000 box, measured on
// ha-6506bw-1.jpg. The drawing is 1600 wide, so the photo sits between
// x = 0 and x = 1000 with 300 units of margin on either side.
const NOTE_EDGE = { left: 230, right: 770 } as const;
const ELBOW = 50;
const PERCENT_PER_UNIT = 0.1;

type Side = keyof typeof NOTE_EDGE;

interface Callout {
  /** The detail the leader points at. */
  anchor: readonly [number, number];
  side: Side;
  /** Height of the note's top rule. */
  y: number;
}

const CALLOUTS = new Map<string, Callout>([
  // The prayer-time row at the foot of the screen.
  ["azan", { anchor: [442, 551], side: "left", y: 720 }],
  // The SE letter on the compass bezel.
  ["qibla", { anchor: [610, 591], side: "right", y: 640 }],
  // The date at the top of the screen.
  ["calendar", { anchor: [591, 387], side: "right", y: 387 }],
  // The sealed case, at its shoulder above the bezel.
  ["water", { anchor: [343, 251], side: "left", y: 251 }],
  // The big digits, where the surah and ayah show.
  ["quran", { anchor: [418, 458], side: "left", y: 470 }],
]);

const leaderPath = (
  [x, y]: readonly [number, number],
  side: Side,
  ruleY: number
): string => {
  const edge = NOTE_EDGE[side];
  const elbow = side === "left" ? edge + ELBOW : edge - ELBOW;

  return `M${x} ${y}L${elbow} ${ruleY}H${edge}`;
};

const notes = features.map((feature, index) => {
  const callout = CALLOUTS.get(feature.icon);

  if (!callout) {
    throw new Error(`No callout for the ${feature.icon} feature.`);
  }

  return {
    ...feature,
    ...callout,
    index: index + 1,
    path: leaderPath(callout.anchor, callout.side, callout.y),
    top: `${callout.y * PERCENT_PER_UNIT}%`,
  };
});

// Rendered at build so the note is never empty; the page script refreshes it.
const hijriToday = new Intl.DateTimeFormat(
  "ar-SA-u-ca-islamic-umalqura-nu-latn",
  {
    day: "numeric",
    month: "long",
    timeZone: "Asia/Amman",
    year: "numeric",
  }
).format(new Date());

const categories = [
  ...new Set(products.map((product) => product.data.category.id)),
];

// One rule per category: when its radio is checked, hide every other card.
// Filtering works without JS; the script below only animates the change.
const filterCss = categories
  .map(
    (id) =>
      `.catalog:has(#filter-${id}:checked) .catalog__item:not([data-category="${id}"]){display:none}`
  )
  .join("");

const phoneParts = JORDAN_PHONE.exec(contact.phone)?.groups;

const phoneLabel = phoneParts
  ? `+962 ${phoneParts.area} ${phoneParts.mid} ${phoneParts.end}`
  : contact.phone;

const siteUrl = new URL("/", Astro.site).href;

const storeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": `${siteUrl}#store`,
      "@type": "OnlineStore",
      address: {
        "@type": "PostalAddress",
        addressCountry: "JO",
        addressLocality: contact.address,
      },
      description: store.tagline,
      logo: new URL("/pwa-512x512.png", Astro.site).href,
      name: store.name,
      telephone: contact.phone,
      url: siteUrl,
    },
    {
      "@type": "WebSite",
      inLanguage: "ar",
      name: store.name,
      publisher: { "@id": `${siteUrl}#store` },
      url: siteUrl,
    },
  ],
};
---

<Layout jsonLd={storeJsonLd}>
  <Fragment slot="head">
    <style is:inline set:html={filterCss}></style>
    <!-- Decide before first paint whether the scroll story runs, so the
         layout never jumps. Without JS the hero is a static drawing. -->
    <script is:inline>
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        document.documentElement.classList.add("scrolly");
      }
    </script>
  </Fragment>

  <main id="main">
    <section aria-labelledby="hero-title" class="anatomy" data-anatomy>
      <div class="stage">
        <div class="drawing">
          <div class="intro">
            <p class="intro__eyebrow">ساعات الحرمين الأصلية في الأردن</p>
            <h1 class="intro__title" id="hero-title">
              لا يفوتك أذان، أينما كنت
            </h1>
            <p class="intro__lede">
              ساعات يد ومكتب تنبّهك لكل صلاة وتدلّك على القبلة. اطلبها عبر واتساب،
              وادفع عند الاستلام.
            </p>
            <div class="intro__actions">
              <a class="btn btn-primary" href="#watches">
                تسوّق الساعات
              </a>
              <a
                class="quiet-link"
                href={chatUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                اسألنا على واتساب
                <span class="visually-hidden">(يفتح في نافذة جديدة)</span>
              </a>
            </div>
            <a class="intro__product" href={`/watches/${hero.id}/`}>
              <span>{hero.data.name}</span>
              <span class="price">
                {formatPrice(hero.data.price, hero.data.currency)}
              </span>
            </a>
          </div>

          <div class="plate">
            <div class="figure">
              <div class="figure__zoom">
                <Picture
                  alt={heroImage.alt}
                  fetchpriority="high"
                  formats={["avif", "webp"]}
                  height={HERO_SIZE}
                  loading="eager"
                  sizes="(min-width: 56rem) min(82vh, 50rem), 130vw"
                  src={heroImage.src}
                  width={HERO_SIZE}
                  widths={[480, 720, HERO_SIZE]}
                />

                <svg aria-hidden="true" class="marks" viewBox="0 0 1000 1000">
                  {notes.map((note) => (
                    <g
                      class="leader"
                      data-note={note.index}
                      style={`--i: ${note.index}`}
                    >
                      <path class="leader__line" d={note.path} pathLength="1" />
                      <circle
                        class="leader__halo"
                        cx={note.anchor[0]}
                        cy={note.anchor[1]}
                        r="15"
                      />
                      <circle
                        class="leader__dot"
                        cx={note.anchor[0]}
                        cy={note.anchor[1]}
                        r="5.5"
                      />
                    </g>
                  ))}
                </svg>
              </div>
            </div>

            <div class="notes" id="features">
              <h2 class="visually-hidden">مزايا الساعة</h2>
              <ol class="notes__list">
                {notes.map((note) => (
                  <li
                    class="note"
                    data-note={note.index}
                    data-side={note.side}
                    style={`--i: ${note.index}; --y: ${note.top}`}
                  >
                    <h3 class="note__title">{note.title}</h3>
                    <p class="note__text">{note.text}</p>
                    {note.icon === "calendar" && (
                      <p class="note__extra">
                        اليوم <span data-hijri>{hijriToday}</span>
                      </p>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>

        <ol aria-hidden="true" class="ticks">
          {notes.map((note) => (
            <li data-note={note.index} style={`--i: ${note.index}`}></li>
          ))}
        </ol>
      </div>
    </section>

    <section aria-labelledby="watches-title" class="catalog" id="watches">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 id="watches-title">الساعات</h2>
            <p class="section-note">
              {digits.format(products.length)} منتجات، كلها أصلية ومكفولة
            </p>
          </div>

          {categories.length > 1 && (
            <fieldset class="filters">
              <legend class="visually-hidden">تصفية حسب الفئة</legend>
              <label class="chip">
                <input checked name="category" type="radio" value="all" />
                الكل
              </label>
              {categories.map((id) => (
                <label class="chip">
                  <input
                    id={`filter-${id}`}
                    name="category"
                    type="radio"
                    value={id}
                  />
                  {categoryName(id)}
                </label>
              ))}
            </fieldset>
          )}
        </div>

        <ul class="catalog__grid">
          {products.map((product) => (
            <li
              class="catalog__item"
              data-category={product.data.category.id}
              style={`--card: card-${product.id}`}
            >
              <ProductCard
                categoryName={categoryName(product.data.category.id)}
                product={product}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="faq-title" class="faq" id="faq">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 id="faq-title">الأسئلة الشائعة</h2>
            <p class="section-note">
              كل ما تحتاج معرفته قبل أن تطلب، ولا تدفع شيئًا قبل أن تصلك الساعة.
            </p>
          </div>
        </div>

        <div class="faq__list">
          <details class="faq__item" name="faq">
            <summary class="faq__question">كيف أطلب ساعتي؟</summary>
            <div class="faq__answer">
              <ol class="steps">
                {steps.map((step, index) => (
                  <li class="step">
                    <span aria-hidden="true" class="step__number">
                      {digits.format(index + 1)}
                    </span>
                    <h3 class="step__title">{step.title}</h3>
                    <p class="step__text">{step.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              كم تكلفة التوصيل وكم يستغرق؟
            </summary>
            <div class="faq__answer">
              <p>نوصل لجميع محافظات الأردن، والرسوم حسب المنطقة:</p>
              <table class="zones">
                <caption class="visually-hidden">
                  رسوم التوصيل ومدته حسب المنطقة
                </caption>
                <thead>
                  <tr>
                    <th scope="col">المنطقة</th>
                    <th scope="col">الرسوم</th>
                    <th scope="col">المدة</th>
                  </tr>
                </thead>
                <tbody>
                  {zones.map((zone) => (
                    <tr>
                      <th scope="row">{zone.data.name}</th>
                      <td class="price">
                        {formatPrice(zone.data.fee, zone.data.currency)}
                      </td>
                      <td>
                        {deliveryTime(zone.data.minDays, zone.data.maxDays)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">كيف أدفع؟</summary>
            <div class="faq__answer">
              <p>
                نقدًا عند الاستلام. تدفع ثمن الساعة مع رسوم التوصيل للمندوب حين
                تصلك، ولا نطلب أي دفعة مسبقة.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              هل أستطيع طلب أكثر من ساعة في طلب واحد؟
            </summary>
            <div class="faq__answer">
              <p>
                نعم، أضف ما تشاء إلى السلة، وتُحسب رسوم التوصيل مرة واحدة على
                الطلب كله.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">هل الساعات أصلية؟</summary>
            <div class="faq__answer">
              <p>
                نعم، كل ساعاتنا من الحرمين الأصلية، وكل ساعة مكفولة بضمان
                {warranty}.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              ما الضمان، وهل أستطيع إرجاع الساعة؟
            </summary>
            <div class="faq__answer">
              <p>
                على كل ساعة ضمان {warranty}، ويمكنك إرجاعها خلال{" "}
                {digits.format(returnDays)} يومًا. راسلنا على واتساب ونرتب معك
                الإرجاع أو الصيانة.
              </p>
            </div>
          </details>

          <details class="faq__item" name="faq">
            <summary class="faq__question">
              كيف أضبط الوقت والمدينة ومواقيت الصلاة؟
            </summary>
            <div class="faq__answer">
              <p>
                جهّزنا فيديوهات قصيرة تشرح الضبط خطوة بخطوة لكل موديل، تجدها في
                <a href="/guides/"> صفحة الشروحات</a>. وإن احتجت مساعدة فنحن على
                واتساب.
              </p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <section aria-labelledby="contact-title" class="contact" id="contact">
      <div class="contact__inner container">
        <div>
          <h2 class="contact__title" id="contact-title">
            عندك سؤال عن ساعة؟ اسألنا قبل أن تطلب.
          </h2>
          <p class="section-note">
            نرد على واتساب ونساعدك تختار الموديل المناسب لك أو لمن تهديه.
          </p>
        </div>
        <div class="contact__actions">
          <a
            class="btn btn-primary"
            href={chatUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            راسلنا على واتساب
            <span class="visually-hidden">(يفتح في نافذة جديدة)</span>
          </a>
          <p class="contact__phone">
            أو اتصل بنا:
            <a dir="ltr" href={`tel:${contact.phone}`}>
              {phoneLabel}
            </a>
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { initAnatomy } from "../lib/anatomy";

  initAnatomy();

  // Animate the filter: cards that stay glide to their new slot, the rest
  // fade out or in. The radio has already flipped when "change" fires, so put
  // the old one back and let the transition flip it after the old snapshot.
  const filters = document.querySelector(".filters");
  let current = filters?.querySelector<HTMLInputElement>("input:checked");
  let latest: ViewTransition | undefined;
  const motionOk = matchMedia("(prefers-reduced-motion: no-preference)");

  filters?.addEventListener("change", async ({ target }) => {
    if (!(target instanceof HTMLInputElement)) {
      return;
    }

    const previous = current;
    current = target;

    if (!(previous && "startViewTransition" in document && motionOk.matches)) {
      return;
    }

    previous.checked = true;
    const root = document.documentElement;
    root.classList.add("filtering");

    const transition = document.startViewTransition(() => {
      target.checked = true;
    });

    latest = transition;

    try {
      await transition.finished;
    } finally {
      // A quick second click skips this transition; keep the class for it.
      if (latest === transition) {
        root.classList.remove("filtering");
      }
    }
  });
</script>

<style>
  /* Buttons and links */

  .quiet-link {
    padding-block: 0.5rem;
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--hairline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
    transition: text-decoration-color 200ms var(--ease);
  }

  .quiet-link:hover {
    text-decoration-color: var(--pine);
  }

  /* ---- The anatomy ----
     Default (reduced motion, no JS): a static, fully annotated drawing.
     The scroll story further down only adds the sticky stage and timing. */

  .stage {
    position: relative;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .drawing {
    inline-size: 100%;
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .intro {
    max-inline-size: 34rem;
    margin-inline: auto;
    text-align: center;
  }

  .intro__eyebrow {
    margin-block-end: 0.75rem;
    color: var(--pine);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .intro__title {
    font-size: clamp(2.125rem, 3.8vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .intro__lede {
    margin-block-start: 1rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    text-wrap: pretty;
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    margin-block-start: 1.75rem;
  }

  .intro__product {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin-block-start: 1.75rem;
    padding-block-start: 0.875rem;
    border-block-start: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 200ms var(--ease);
  }

  .intro__product .price {
    color: var(--ink);
    font-weight: 500;
  }

  .intro__product:hover {
    color: var(--ink);
  }

  /* The plate is the drawing sheet: 1600 × 1000 units, the photo square in
     the middle third, notes on the white flanks. */
  .plate {
    position: relative;
    aspect-ratio: 16 / 10;
    margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
  }

  .figure {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 18.75%;
    inline-size: 62.5%;
  }

  .figure__zoom {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
  }

  /* The studio backdrop is 254 white in places; lift it to the page. */
  .figure__zoom :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    filter: brightness(1.02);
  }

  .marks {
    position: absolute;
    inset: 0;
    overflow: visible;
    inline-size: 100%;
    block-size: 100%;
    fill: none;
    stroke-linecap: round;
  }

  .leader__line {
    stroke: var(--line);
    stroke-dasharray: 1;
    stroke-width: 2;
  }

  .leader__dot {
    transform-box: fill-box;
    transform-origin: center;
    fill: var(--pine);
    stroke: var(--white);
    stroke-width: 2.5;
  }

  .leader__halo {
    opacity: 0;
    stroke: var(--pine);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
  }

  .notes__list {
    position: absolute;
    inset: 0;
  }

