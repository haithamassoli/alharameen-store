</Layout>

<script>
  import { initAnatomy } from "../lib/anatomy";

  initAnatomy();

  // Animate the filter: cards that stay glide to their new slot, the rest
  // fade out or in. The radio has already flipped when "change" fires, so put
  // the old one back and let the transition flip it after the old snapshot.
  const filters = document.querySelector(".filters");
  let current = filters?.querySelector<HTMLInputElement>("input:checked");
  let latest: ViewTransition | undefined;
  const motionOk = matchMedia("(prefers-reduced-motion: no-preference)");

  filters?.addEventListener("change", async ({ target }) => {
    if (!(target instanceof HTMLInputElement)) {
      return;
    }

    const previous = current;
    current = target;

    if (!(previous && "startViewTransition" in document && motionOk.matches)) {
      return;
    }

    previous.checked = true;
    const root = document.documentElement;
    root.classList.add("filtering");

    const transition = document.startViewTransition(() => {
      target.checked = true;
    });

    latest = transition;

    try {
      await transition.finished;
    } finally {
      // A quick second click skips this transition; keep the class for it.
      if (latest === transition) {
        root.classList.remove("filtering");
      }
    }
  });
</script>

