---
// Style exploration 9, «الأسطرلاب»: /1's white showroom, opened by an
// astrolabe. Five thin porcelain and brass rings, one per feature, circle the
// real watch photo; scrolling turns them one by one into a flat plate and a
// brass rule swings to the Qibla. The rings are a static SVG at first paint;
// three.js (src/lib/style-9-scene.ts) takes over only when WebGL is there,
// motion is allowed and the hero is on screen.
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/500.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import { Picture } from "astro:assets";

import logo from "../assets/logo.svg";
import { deliveryTime } from "../lib/delivery";
import { getHomeData } from "../lib/home-data";
import { formatPrice } from "../lib/money";

const {
  store,
  products,
  categoryName,
  zones,
  chatUrl,
  digits,
  features,
  steps,
} = await getHomeData();

const HERO_SIZE = 960;
const CARD_SIZE = 560;
const JORDAN_PHONE = /^\+962(?<area>\d{2})(?<mid>\d{3})(?<end>\d{4})$/u;

// The black sport watch: its compass bezel already speaks the astrolabe's
// language. The ring geometry below is fitted to this photo's case.
const HERO_MODEL = "HA-6506BW";

const hero =
  products.find((product) => product.data.model === HERO_MODEL) ??
  products.find((product) => product.data.featured);

if (!hero) {
  throw new Error("The home page needs at least one product.");
}

const [heroImage] = hero.data.images;

if (!heroImage) {
  throw new Error(`${hero.id} has no photo.`);
}

// ---- Astrolabe geometry, shared with the three.js scene. ----
// Scene units: the instrument square spans ±SCENE_HALF; the photo fills it,
// nudged so the watch case (radius ≈ 0.54, buttons ≈ 0.59) sits dead centre.
const VIEW = 1000;
const MID = VIEW / 2;
const SCENE_HALF = 1.15;
const SCALE = MID / SCENE_HALF;
const RAD = Math.PI / 180;
const ARC_STEPS = 144;
const LABEL_ANGLE = 128;
const LABEL_GAP = 0.042;
const PRECISION = 10;

// Qibla from Amman, degrees clockwise from north: an example for the copy,
// not a calculation for the visitor's location.
const QIBLA_BEARING = 157;

// Tilts keep every loose ring clear of the watch face (minor axis ≥ 0.6).
const RING_LAYOUT = [
  { axis: 95, brass: false, radius: 0.63, ticks: false, tilt: 18 },
  { axis: 30, brass: true, radius: 0.715, ticks: false, tilt: -32 },
  { axis: 140, brass: false, radius: 0.8, ticks: false, tilt: 40 },
  { axis: 70, brass: false, radius: 0.885, ticks: false, tilt: -46 },
  { axis: -12, brass: false, radius: 0.975, ticks: true, tilt: 50 },
] as const;

type RingLayout = (typeof RING_LAYOUT)[number];

interface Point {
  x: number;
  y: number;
  z: number;
}

const round = (value: number): number =>
  Math.round(value * PRECISION) / PRECISION;

/** A point in the ring's plane, tilted then turned as the loose ring is. */
const place = (ring: RingLayout, x: number, y: number): Point => {
  const tilt = ring.tilt * RAD;
  const axis = ring.axis * RAD;
  const lifted = y * Math.cos(tilt);

  return {
    x: x * Math.cos(axis) - lifted * Math.sin(axis),
    y: x * Math.sin(axis) + lifted * Math.cos(axis),
    z: y * Math.sin(tilt),
  };
};

const toView = (point: Point): string =>
  `${round(MID + point.x * SCALE)} ${round(MID - point.y * SCALE)}`;

const toPath = (runs: readonly Point[][]): string =>
  runs.map((run) => `M${run.map(toView).join("L")}`).join("");

/** The ring's outline, split into the arcs behind and in front of the photo. */
interface Arcs {
  back: string;
  front: string;
}

const ringArcs = (ring: RingLayout): Arcs => {
  const back: Point[][] = [];
  const front: Point[][] = [];
  let run: Point[] = [];
  let inFront: boolean | null = null;

  for (let step = 0; step <= ARC_STEPS; step += 1) {
    const angle = (step / ARC_STEPS) * Math.PI * 2;

    const point = place(
      ring,
      Math.cos(angle) * ring.radius,
      Math.sin(angle) * ring.radius
    );

    const side = point.z >= 0;

    if (inFront !== null && side !== inFront) {
      run.push(point);
      (inFront ? front : back).push(run);
      run = [];
    }

    inFront = side;
    run.push(point);
  }

  (inFront ? front : back).push(run);

  return { back: toPath(back), front: toPath(front) };
};

const TICK_COUNT = 72;
const TICKS_PER_HOUR = 6;
const TICK_INSET = 0.016;

const tickPath = (ring: RingLayout): string => {
  const parts: string[] = [];
  const outer = ring.radius - TICK_INSET;

  for (let index = 0; index < TICK_COUNT; index += 1) {
    const angle = 90 * RAD - (index / TICK_COUNT) * Math.PI * 2;
    const isHour = index % TICKS_PER_HOUR === 0;
    let length = isHour ? 0.044 : 0.022;

    if (index === 0) {
      length = 0.064;
    }

    const from = place(ring, Math.cos(angle) * outer, Math.sin(angle) * outer);

    const to = place(
      ring,
      Math.cos(angle) * (outer - length),
      Math.sin(angle) * (outer - length)
    );

    parts.push(`M${toView(from)}L${toView(to)}`);
  }

  return parts.join("");
};

const rings = features.map((feature, index) => {
  const layout = RING_LAYOUT[index % RING_LAYOUT.length];
  const labelRadius = layout.radius + LABEL_GAP;

  const labelPoint = place(
    layout,
    Math.cos(LABEL_ANGLE * RAD) * labelRadius,
    Math.sin(LABEL_ANGLE * RAD) * labelRadius
  );

  return {
    ...layout,
    ...ringArcs(layout),
    feature,
    label: digits.format(index + 1),
    labelX: round(MID + labelPoint.x * SCALE),
    labelY: round(MID - labelPoint.y * SCALE),
    ticksPath: layout.ticks ? tickPath(layout) : "",
  };
});

const ringData = JSON.stringify(
  rings.map(({ axis, brass, label, radius, ticks, tilt }) => ({
    axis,
    brass,
    label,
    radius,
    ticks,
    tilt,
  }))
);

// The finished plate's Qibla rule, for the SVG and the label beside its tip.
const RULE_INNER = 0.66;
const RULE_OUTER = 1.03;
const RULE_TIP = 1.105;
const RULE_HALF_WIDTH = 0.026;

const bearingPoint = (radius: number, bearing: number, side = 0): Point => {
  const angle = bearing * RAD;
  const across = (bearing + 90) * RAD;

  return {
    x: Math.sin(angle) * radius + Math.sin(across) * side,
    y: Math.cos(angle) * radius + Math.cos(across) * side,
    z: 0,
  };
};

const rulePath = `M${toView(bearingPoint(RULE_INNER, QIBLA_BEARING))}L${toView(bearingPoint(RULE_OUTER, QIBLA_BEARING))}`;

const ruleTip = [
  bearingPoint(RULE_OUTER, QIBLA_BEARING, RULE_HALF_WIDTH),
  bearingPoint(RULE_TIP, QIBLA_BEARING),
  bearingPoint(RULE_OUTER, QIBLA_BEARING, -RULE_HALF_WIDTH),
]
  .map(toView)
  .join(" ");

const tipPoint = bearingPoint(RULE_TIP, QIBLA_BEARING);
const PERCENT = 100;
const qiblaX = round(((MID + tipPoint.x * SCALE) / VIEW) * PERCENT);
const qiblaY = round(((MID - tipPoint.y * SCALE) / VIEW) * PERCENT);
const qiblaExample = `مثال من عمّان ${digits.format(QIBLA_BEARING)}°`;

const categories = [
  ...new Map(
    products.map((product) => [product.data.category.id, categoryName(product)])
  ),
];

// One rule per category: when its radio is checked, hide every other card.
const filterCss = categories
  .map(
    ([id]) =>
      `.catalog:has(#filter-${id}:checked) .catalog__item:not([data-category="${id}"]){display:none}`
  )
  .join("");

const phoneMatch = JORDAN_PHONE.exec(store.contact.phone);

const phoneParts = phoneMatch?.groups;

const phoneLabel = phoneParts
  ? `+962 ${phoneParts.area} ${phoneParts.mid} ${phoneParts.end}`
  : store.contact.phone;

const [cheapestZone] = zones;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{store.name} | الأسطرلاب</title>
    <meta name="description" content={store.tagline} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline set:html={filterCss}></style>
  </head>
  <body>
    <a class="skip" href="#main">
      تخطَّ إلى المحتوى
    </a>

    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="brand" href="/9">
          <img
            alt=""
            class="brand__mark"
            height="28"
            src={logo.src}
            width="28"
          />
          <span>{store.name}</span>
        </a>
        <nav aria-label="أقسام الصفحة" class="masthead__nav">
          <ul>
            <li>
              <a href="#catalog">الساعات</a>
            </li>
            <li>
              <a href="#features">المزايا</a>
            </li>
            <li>
              <a href="#order">طريقة الطلب</a>
            </li>
            <li>
              <a href="#contact">تواصل معنا</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <section aria-labelledby="hero-title" class="hero" data-hero>
        <div class="wrap hero__stage" data-stage>
          <div class="hero__intro">
            <p class="hero__eyebrow rise" style="--i: 0">
              ساعات الحرمين الأصلية في الأردن
            </p>
            <h1 class="hero__title rise" id="hero-title" style="--i: 1">
              لا يفوتك أذان، أينما كنت
            </h1>
          </div>

          <figure class="hero__figure">
            <div
              class="instrument"
              data-bearing={QIBLA_BEARING}
              data-instrument
              data-rings={ringData}
            >
              <svg
                aria-hidden="true"
                class="instrument__layer instrument__svg"
                viewBox={`0 0 ${VIEW} ${VIEW}`}
              >
                {rings.map((ring, index) => (
                  <g
                    class:list={["ring", { "ring--brass": ring.brass }]}
                    data-ring={index}
                  >
                    <path class="ring__line" d={ring.back} />
                    {ring.ticksPath && (
                      <path class="ring__ticks" d={ring.ticksPath} />
                    )}
                    <text class="ring__label" x={ring.labelX} y={ring.labelY}>
                      {ring.label}
                    </text>
                  </g>
                ))}
              </svg>
              <canvas
                aria-hidden="true"
                class="instrument__layer instrument__canvas"
                data-layer="back"
              ></canvas>
              <Picture
                alt={heroImage.alt}
                fetchpriority="high"
                formats={["avif", "webp"]}
                height={HERO_SIZE}
                loading="eager"
                sizes="(min-width: 72rem) and (min-height: 40rem) min(46rem, 100vh - 10.5rem), min(100vw, 54vh)"
                src={heroImage.src}
                width={HERO_SIZE}
                widths={[400, 600, 800, HERO_SIZE]}
              />
              <svg
                aria-hidden="true"
                class="instrument__layer instrument__svg instrument__svg--front"
                viewBox={`0 0 ${VIEW} ${VIEW}`}
              >
                {rings.map((ring, index) => (
                  <g
                    class:list={["ring", { "ring--brass": ring.brass }]}
                    data-ring={index}
                  >
                    <path class="ring__line" d={ring.front} />
                  </g>
                ))}
                <g class="rule">
                  <path d={rulePath} />
                  <polygon points={ruleTip} />
                </g>
              </svg>
              <canvas
                aria-hidden="true"
                class="instrument__layer instrument__canvas instrument__canvas--front"
                data-layer="front"
              ></canvas>
              <p class="qibla" style={`--qx: ${qiblaX}%; --qy: ${qiblaY}%`}>
                <span>اتجاه القبلة</span>
                <span class="qibla__dot"> · </span>
                <span>{qiblaExample}</span>
              </p>
            </div>
            <figcaption class="hero__caption">
              <a href={`/watches/${hero.id}/`}>{hero.data.name}</a>
              <span class="price">
                {formatPrice(hero.data.price, hero.data.currency)}
              </span>
            </figcaption>
          </figure>

          <div class="hero__more">
            <p class="hero__lede rise" style="--i: 2">
              ما كان يحسبه الأسطرلاب صار على معصمك: مواقيت الأذان واتجاه القبلة.
              اختر ساعتك، واطلبها عبر واتساب، وادفع عند الاستلام.
            </p>
            <div class="hero__actions rise" style="--i: 3">
              <a class="button" href="#catalog">
                تسوّق الساعات
              </a>
              <a
                class="quiet-link"
                href={chatUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                اسألنا على واتساب
                <span class="visually-hidden">(يفتح في نافذة جديدة)</span>
              </a>
            </div>
          </div>

          <div class="legend" id="features">
            <h2 class="visually-hidden">مزايا كل ساعة</h2>
            <ol class="legend__list">
              {rings.map((ring, index) => (
                <li class="legend__item" data-item>
                  <button
                    aria-pressed={index === 0 ? "true" : "false"}
                    class="legend__button"
                    data-feature={index}
                    type="button"
                  >
                    <span aria-hidden="true" class="legend__index">
                      {ring.label}
                    </span>
                    <span class="legend__title">{ring.feature.title}</span>
                  </button>
                  <p class="legend__text">{ring.feature.text}</p>
                </li>
              ))}
            </ol>
            <p class="legend__hint">
              كل حلقة حول الساعة تحمل رقم ميزة. اختر ميزة، أو مرّر الصفحة، لتصطف
              الحلقات.
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="catalog-title" class="catalog" id="catalog">
        <div class="wrap">
          <div class="section-head catalog__head">
            <div>
              <h2 class="section-title" id="catalog-title">
                الساعات
              </h2>
              <p class="section-note">
                {digits.format(products.length)} منتجات، كلها أصلية ومكفولة
              </p>
            </div>

            {categories.length > 1 && (
              <fieldset class="filters">
                <legend class="visually-hidden">تصفية حسب الفئة</legend>
                <label class="chip">
                  <input checked name="category" type="radio" value="all" />
                  الكل
                </label>
                {categories.map(([id, name]) => (
                  <label class="chip">
                    <input
                      id={`filter-${id}`}
                      name="category"
                      type="radio"
                      value={id}
                    />
                    {name}
                  </label>
                ))}
              </fieldset>
            )}
          </div>

          <ul class="catalog__grid">
            {products.map((product) => {
              const [cover] = product.data.images;
              const { compareAtPrice, currency, price } = product.data;

              return (
                <li
                  class="catalog__item"
                  data-category={product.data.category.id}
                >
                  <article class="card">
                    <div class="card__frame">
                      <Picture
                        alt={cover.alt}
                        formats={["avif", "webp"]}
                        height={CARD_SIZE}
                        loading="lazy"
                        sizes="(min-width: 64rem) 17rem, (min-width: 40rem) 30vw, 45vw"
                        src={cover.src}
                        width={CARD_SIZE}
                        widths={[280, 420, CARD_SIZE]}
                      />
                    </div>
                    <div class="card__body">
                      <p class="card__category">{categoryName(product)}</p>
                      <h3 class="card__name">
                        <a href={`/watches/${product.id}/`}>
                          {product.data.name}
                        </a>
                      </h3>
                      <p class="card__price price">
                        <span class="visually-hidden">السعر:</span>
                        {formatPrice(price, currency)}
                        {compareAtPrice !== undefined && (
                          <s class="card__was">
                            <span class="visually-hidden">بدلًا من</span>
                            {formatPrice(compareAtPrice, currency)}
                          </s>
                        )}
                      </p>
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <section aria-labelledby="order-title" class="order" id="order">
        <div class="wrap">
          <div class="section-head">
            <div>
              <h2 class="section-title" id="order-title">
                طريقة الطلب
              </h2>
              <p class="section-note">
                ثلاث خطوات، ولا تدفع شيئًا قبل أن تصلك الساعة.
              </p>
            </div>
          </div>

          <ol class="steps">
            {steps.map((step, index) => (
              <li class="step">
                <span aria-hidden="true" class="step__number">
                  {digits.format(index + 1)}
                </span>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </li>
            ))}
          </ol>

          <div class="delivery">
            <h3 class="delivery__title">التوصيل</h3>
            <table class="zones">
              <caption class="visually-hidden">
                رسوم التوصيل ومدته حسب المنطقة
              </caption>
              <thead>
                <tr>
                  <th scope="col">المنطقة</th>
                  <th scope="col">الرسوم</th>
                  <th scope="col">المدة</th>
                </tr>
              </thead>
              <tbody>
                {zones.map((zone) => (
                  <tr>
                    <th scope="row">{zone.data.name}</th>
                    <td class="price">
                      {formatPrice(zone.data.fee, zone.data.currency)}
                    </td>
                    <td>
                      {deliveryTime(zone.data.minDays, zone.data.maxDays)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="delivery__cash">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <rect height="11" rx="1.5" width="18" x="3" y="7"></rect>
                <circle cx="12" cy="12.5" r="2.5"></circle>
              </svg>
              الدفع نقدًا عند الاستلام
              {cheapestZone && (
                <span class="delivery__from">
                  ، والتوصيل يبدأ من{" "}
                  {formatPrice(
                    cheapestZone.data.fee,
                    cheapestZone.data.currency
                  )}
                </span>
              )}
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="contact-title" class="contact" id="contact">
        <div class="wrap contact__inner">
          <div>
            <h2 class="contact__title" id="contact-title">
              عندك سؤال عن ساعة؟ اسألنا قبل أن تطلب.
            </h2>
            <p class="section-note">
              نرد على واتساب ونساعدك تختار الموديل المناسب لك أو لمن تهديه.
            </p>
          </div>
          <div class="contact__actions">
            <a
              class="button"
              href={chatUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              راسلنا على واتساب
              <span class="visually-hidden">(يفتح في نافذة جديدة)</span>
            </a>
            <p class="contact__phone">
              أو اتصل بنا:
              <a dir="ltr" href={`tel:${store.contact.phone}`}>
                {phoneLabel}
              </a>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <p>
          {store.name}، {store.contact.address}
        </p>
        <p>
          © <span>{digits.format(year).replaceAll("٬", "")}</span>
        </p>
      </div>
    </footer>

    <script>
      import type { Astrolabe } from "../lib/style-9-scene";

      // Keep in sync with the CSS media query of the sticky desktop stage.
      const STAGE_QUERY = "(min-width: 72rem) and (min-height: 40rem)";
      const REDUCED_MOTION = "(prefers-reduced-motion: reduce)";
      const PRELOAD_MARGIN = "200px";

      /** Extra scroll after the last ring locks, so the plate rests a while. */
      const HOLD = 0.7;

      /** The Qibla label shows once the rule has nearly finished its swing. */
      const QIBLA_SLACK = 0.12;

      /** On narrow screens an item counts as read as it crosses this line. */
      const READ_LINE = 0.8;

      const clamp = (value: number, min: number, max: number): number =>
        Math.min(max, Math.max(min, value));

      const hasWebGL2 = (): boolean => {
        try {
          const probe = document.createElement("canvas").getContext("webgl2");
          probe?.getExtension("WEBGL_lose_context")?.loseContext();

          return probe !== null;
        } catch {
          return false;
        }
      };

      const setupAstrolabe = (): void => {
        const hero = document.querySelector<HTMLElement>("[data-hero]");
        const stage = hero?.querySelector<HTMLElement>("[data-stage]");

        const instrument =
          hero?.querySelector<HTMLElement>("[data-instrument]");

        const back = instrument?.querySelector<HTMLCanvasElement>(
          "[data-layer='back']"
        );

        const front = instrument?.querySelector<HTMLCanvasElement>(
          "[data-layer='front']"
        );

        if (!hero || !stage || !instrument || !back || !front) {
          return;
        }

        const buttons = [
          ...hero.querySelectorAll<HTMLButtonElement>("[data-feature]"),
        ];

        const items = [...hero.querySelectorAll<HTMLElement>("[data-item]")];

        const rings = [
          ...instrument.querySelectorAll<SVGGElement>("[data-ring]"),
        ];

        const count = buttons.length;
        const reduced = window.matchMedia(REDUCED_MOTION).matches;
        const stageQuery = window.matchMedia(STAGE_QUERY);

        let scene: Astrolabe | null = null;
        let progress = 0;

        const show = (value: number): void => {
          progress = clamp(value, 0, count);
          const active = clamp(Math.ceil(progress) - 1, 0, count - 1);

          for (const [index, button] of buttons.entries()) {
            button.setAttribute("aria-pressed", String(index === active));
          }

          for (const ring of rings) {
            ring.classList.toggle(
              "is-active",
              ring.dataset.ring === String(active)
            );
          }

          // Without motion the plate never turns, so the rule just stays.
          instrument.dataset.qibla = String(
            reduced || progress >= count - QIBLA_SLACK
          );

          scene?.setProgress(progress);
        };

        /** How far the pinned stage has travelled down its scroll track. */
        const track = () => {
          const heroRect = hero.getBoundingClientRect();
          const stageRect = stage.getBoundingClientRect();

          return {
            range: heroRect.height - stageRect.height,
            travelled: stageRect.top - heroRect.top,
          };
        };

        /** Scroll position → ring progress, 0 (all loose) to count. */
        const readProgress = (): number => {
          if (stageQuery.matches) {
            const { range, travelled } = track();

            if (range <= 0) {
              return progress;
            }

            return clamp(travelled / range, 0, 1) * (count + HOLD);
          }

          const line = window.innerHeight * READ_LINE;
          let read = 0;

          for (const item of items) {
            const rect = item.getBoundingClientRect();
            read += clamp((line - rect.top) / rect.height, 0, 1);
          }

          return read;
        };

        /** How far to scroll so readProgress() lands on `goal`. */
        const distanceTo = (goal: number): number => {
          if (stageQuery.matches) {
            const { range, travelled } = track();

            return (goal / (count + HOLD)) * range - travelled;
          }

          const item = items.at(goal - 1);

          if (!item) {
            return 0;
          }

          const rect = item.getBoundingClientRect();

          return rect.top - (window.innerHeight * READ_LINE - rect.height);
        };

        for (const [index, button] of buttons.entries()) {
          button.addEventListener("click", () => {
            const goal = index + 1;
            const distance = reduced ? 0 : distanceTo(goal);

            if (Math.abs(distance) < 2) {
              show(goal);

              return;
            }

            window.scrollBy({ behavior: "smooth", top: distance });
          });
        }

        show(0);

        if (reduced) {
          return;
        }

        let frame = 0;

        const follow = (): void => {
          frame = 0;
          show(readProgress());
        };

        const onScroll = (): void => {
          if (frame === 0) {
            frame = requestAnimationFrame(follow);
          }
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        follow();

        if (!hasWebGL2()) {
          return;
        }

        let requested = false;
        let inView = false;

        const sync = (): void => {
          if (inView && document.visibilityState === "visible") {
            scene?.start();
          } else {
            scene?.stop();
          }
        };

        const load = async (): Promise<void> => {
          requested = true;

          try {
            const { createAstrolabe } = await import("../lib/style-9-scene");

            scene = await createAstrolabe({
              back,
              container: instrument,
              front,
              progress,
              qiblaBearing: Number(instrument.dataset.bearing),
              rings: instrument.dataset.rings ?? "[]",
            });

            instrument.dataset.state = "live";
          } catch {
            // Keep the SVG rings if three.js or WebGL fails.
            instrument.dataset.state = "static";
          }

          sync();
        };

        const observer = new IntersectionObserver(
          (entries) => {
            inView = entries.some((entry) => entry.isIntersecting);

            if (inView && !requested) {
              load();

              return;
            }

            sync();
          },
          { rootMargin: PRELOAD_MARGIN }
        );

        observer.observe(instrument);
        document.addEventListener("visibilitychange", sync);

        window.addEventListener("pagehide", (event) => {
          if (event.persisted) {
            scene?.stop();

            return;
          }

          observer.disconnect();
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
          scene?.dispose();
          scene = null;
        });
      };

      setupAstrolabe();
    </script>
  </body>
</html>

