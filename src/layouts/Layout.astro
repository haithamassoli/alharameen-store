---
import "@fontsource/amiri/400.css";
import "@fontsource/amiri/700.css";
import "@fontsource-variable/reem-kufi";
import "@fontsource-variable/noto-naskh-arabic";
import "../styles/global.css";
import CartDrawer from "../components/CartDrawer.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getStore } from "../lib/store";

interface Props {
  /** Page-specific title; the store name is appended. Omit on the home page. */
  title?: string;
  /** Meta description; defaults to the store tagline. */
  description?: string;
  /** Share image (absolute or root-relative); defaults to the 1200×630 store card. */
  image?: { alt: string; height: number; src: string; width: number };
  /** schema.org JSON-LD for rich results. */
  jsonLd?: object;
  /** Keep the page out of search results (e.g. the 404). */
  noindex?: boolean;
}

const store = await getStore();

const {
  title,
  description = store.tagline,
  image = {
    alt: `${store.name}: لا يفوتك أذان، أينما كنت`,
    height: 630,
    src: "/og-image.jpg",
    width: 1200,
  },
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${store.name}`
  : `${store.name} | ساعات الأذان الأصلية في الأردن`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image.src, Astro.site);

// Escape "<" so data can never close the <script> element early.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replaceAll("<", "\\u003c");
---

<!doctype html>
<html dir="rtl" lang="ar">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/favicon.ico" rel="icon" />
    <link href="/apple-touch-icon-180x180.png" rel="apple-touch-icon" />
    <link href="/manifest.webmanifest" rel="manifest" />
    <!-- The header is lacquer in both themes, so the browser chrome matches it. -->
    <meta content="#0e110f" name="theme-color" />
    <!-- Apply a stored night theme before first paint (no flash). Day is the
         default even when the OS prefers dark; Header.astro owns the toggle. -->
    <script is:inline>
      try {
        if (localStorage.getItem("alharameen-theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      } catch {
        // Storage blocked: stay on the default day theme.
      }
    </script>
    <meta content={description} name="description" />
    {noindex && <meta content="noindex" name="robots" />}
    {!noindex && <link href={canonical} rel="canonical" />}
    <meta content={store.name} property="og:site_name" />
    <meta content="ar_JO" property="og:locale" />
    <meta content="website" property="og:type" />
    <meta content={pageTitle} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={imageUrl} property="og:image" />
    <meta content={String(image.width)} property="og:image:width" />
    <meta content={String(image.height)} property="og:image:height" />
    <meta content={image.alt} property="og:image:alt" />
    <meta content="summary_large_image" name="twitter:card" />
    {jsonLdText && (
      <script is:inline set:html={jsonLdText} type="application/ld+json" />
    )}
    <meta content={Astro.generator} name="generator" />
    <title>{pageTitle}</title>
    <!-- ponytail: registerSW.js is emitted by @vite-pwa/astro at build; 404 in dev is expected (SW disabled in dev). -->
    <script defer src="/registerSW.js" is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      تخطَّ إلى المحتوى
    </a>
    <Header />
    <slot />
    <Footer />
    <CartDrawer />
  </body>
</html>
