{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/astro"
  ],
  "overrides": [
    {
      // Astro convention: components and layouts are PascalCase (e.g. ProductCard.astro).
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["kebab-case", "PascalCase"]
              }
            }
          }
        }
      }
    }
  ]
}
